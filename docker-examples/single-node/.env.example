# Copy to .env. The secrets, the bucket and the database are in golem.env; see README.md.

GOLEM_IMAGE_VERSION=v1.6.0

# DNS names that point at this host. Caddy gets a certificate for each of them.
GOLEM_MANAGEMENT_HOST=golem.example.com
# Comma-separated domains of the HTTP API and MCP deployments.
GOLEM_APP_DOMAINS=api.example.com, mcp.example.com

# Replicate the SQLite databases to S3 with Litestream (single node mode only, and only from the
# first start of a new golem_data volume). For an S3-compatible service, add the endpoint and the
# region to the query: s3://my-bucket/litestream?endpoint=https://s3.example.com&region=auto. Off by default, and not
# needed on a reliable persistent disk. One server per replica URL; asynchronous (about once a second),
# so the newest writes can be lost with the disk; only missing databases are restored at startup.
# See https://learn.golem.cloud/next/deploy/server#litestream-limits
GOLEM_LITESTREAM=false
GOLEM_LITESTREAM_REPLICA_URL=s3://my-bucket/litestream
