# Copy to .env and fill in every value. Keep .env out of version control.

GOLEM_IMAGES_VERSION=v1.6.0-rc3
WORKER_EXECUTOR_REPLICAS=3

# DNS names that point at this host. Caddy gets a certificate for each of them.
GOLEM_MANAGEMENT_HOST=golem.example.com
# Comma-separated domains of the HTTP API and MCP deployments.
GOLEM_APP_DOMAINS=api.example.com, mcp.example.com
CORS_ORIGIN_REGEX=https://golem.example.com

# Generate each token with `openssl rand -hex 32` and each key with `openssl rand -base64 32`.
ADMIN_TOKEN=
MARKETING_TOKEN=
WEBHOOK_HMAC_KEY=
SESSION_TOKEN_KEY_ID=key-1
SESSION_TOKEN_KEY=

# The database user must be able to create schemas in the database.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=golem
POSTGRES_USER=golem
POSTGRES_PASSWORD=

S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
