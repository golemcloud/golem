        "stdinCleanup": "not-declared",
        "ownerOutcome": "completed",
        "leafEffectCount": 1
      }
    },
    {
      "id": "render-typed-error",
      "surfacePath": ["artifact", "render"],
      "canonicalPath": ["render"],
      "principal": "principal:alice",
