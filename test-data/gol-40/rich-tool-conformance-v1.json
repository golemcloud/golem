        { "name": "profile", "value": "release", "origin": "current-node-global" },
        { "name": "request", "value": { "source": "src/main.wasm", "labels": { "team": "runtime", "tier": "gold" } }, "origin": "fixed-positional" },
        { "name": "inputs", "value": ["src/a.wasm", "src/b.wat"], "origin": "tail-positional" },
        { "name": "format", "value": "json", "origin": "body-option" },
        { "name": "tag", "value": ["release", "signed"], "origin": "body-option" },
        { "name": "define", "value": { "opt": 3, "workers": 2 }, "origin": "body-option" },
        { "name": "color", "value": "never", "origin": "body-option" },
        { "name": "checksum", "value": true, "origin": "body-flag" },
        { "name": "verbose", "value": 2, "origin": "body-flag" }
      ],
