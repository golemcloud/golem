        "stdinCleanup": "closed",
        "ownerOutcome": "completed-with-declared-error",
        "leafEffectCount": 1
      }
    }
  ],
  "comparison": {
    "knownSemanticallyUnorderedCollections": [
      {
        "path": "tool.schemaDefinitions",
        "key": "definition id",
        "evidence": "golem-schema/src/schema/tool/compatibility/tests.rs::strict_equality_canonicalizes_reordered_alpha_renamed_recursive_defs"
      }
    ],
    "orderSensitiveCollections": [
      "command-tree traversal and canonical command paths",
      "canonical input fields: inherited globals root-to-leaf, fixed positionals, tail positional, body options, body flags",
      "record fields and tuple elements",
      "aliases, constraints, declared errors, and result formatters in emitted metadata",
      "documentation examples",
      "stream MIME types when projected to MCP because the first MIME type is selected for a finite output channel"
    ],
    "permittedDifferences": [],
    "rule": "Do not add an SDK/version exception or normalize another field without a demonstrated semantic or representation difference."
  }
}
