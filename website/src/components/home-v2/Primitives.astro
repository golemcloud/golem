---
import { text as t, paragraphs, lines, details } from "../../data/home-preview/golem-2";
const calls = [1, 2, 3];
const topics = [
  { id: "actor", title: "Actor lifetime and calls" },
  { id: "invocation", title: "Function durability and state" },
  { id: "function", title: "Function identity and middleware" },
];
---

<div class="primitive-comparison">
  {
    ["Actors", "Functions"].map((kind) => (
      <article>
        <div class="primitive-title">
          <h3>{kind}</h3>
          <span>{paragraphs(t(2, kind))[0]}</span>
        </div>
        <p>{paragraphs(t(2, kind))[1]}</p>
        {kind === "Actors" ? (
          <figure
            class="primitive-diagram"
            role="group"
            aria-label="Three calls to the same actor ID reach one actor inside its durable, permissioned VM. The actor retains private state across calls."
          >
            <div class="actor-flow" aria-hidden="true">
              <div class="actor-calls">
                {calls.map((n) => (
                  <span>Call {n}</span>
                ))}
              </div>
              <div class="actor-arrows">
                {calls.map(() => (
                  <span class="primitive-arrow" />
                ))}
              </div>
              <div class="primitive-enclosure actor-enclosure">
                <span class="primitive-vm-label">Durable, permissioned VM</span>
                <div class="actor-instance">
                  <span class="primitive-symbol">α</span>
                  <strong>Actor</strong>
                  <span class="actor-id">ID: 42</span>
                </div>
              </div>
            </div>
            <div class="annotation-footer actor-annotation">
              <button
                class="diagram-hotspot"
                data-topic="actor"
                type="button"
                aria-label="Explore actor lifetime and calls"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="primitive-info-actor"
              >
                <span class="hotspot-label">Lifetime &amp; calls</span>
                <span class="hotspot-icon" aria-hidden="true">
                  +
                </span>
              </button>
            </div>
          </figure>
        ) : (
          <figure
            class="primitive-diagram"
            role="group"
            aria-label="Three independent calls run the same function f. Each call has its own input, output and fresh durable, permissioned VM. No private instance state carries into the next call."
          >
            <div class="function-label">
              <span>
                Function <i>f</i>
              </span>
              <span class="inline-annotation-wire" aria-hidden="true" />
              <button
                class="diagram-hotspot"
                data-topic="function"
                type="button"
                aria-label="Explore function identity and middleware"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="primitive-info-function"
              >
                <span class="hotspot-label">Identity &amp; middleware</span>
                <span class="hotspot-icon" aria-hidden="true">
                  +
                </span>
              </button>
            </div>
            <div class="function-flow" aria-hidden="true">
              {calls.map((n) => (
                <div class="function-call">
                  <span class="call-label">Call {n}</span>
                  <span class="primitive-arrow" />
                  <div class="primitive-enclosure function-enclosure" data-invocation={n}>
                    <span class="primitive-vm-label">Durable, permissioned VM</span>
                    <span class="primitive-symbol">ƒ</span>
                  </div>
                  <span class="primitive-arrow" />
                  <span class="call-label">Output {n}</span>
                </div>
              ))}
            </div>
            <div class="annotation-footer function-annotation">
              <button
                class="diagram-hotspot"
                data-topic="invocation"
                type="button"
                aria-label="Explore function durability and state"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="primitive-info-invocation"
              >
                <span class="hotspot-label">Durability &amp; state</span>
                <span class="hotspot-icon" aria-hidden="true">
                  +
                </span>
              </button>
            </div>
          </figure>
        )}
        <div class="primitive-examples">
          <p>Examples</p>
          <ul>
            {lines(t(2, kind === "Actors" ? "Actor examples" : "Function examples")).map(
              (example) => (
                <li>{example}</li>
              )
            )}
          </ul>
        </div>
      </article>
    ))
  }
</div>

{
  topics.map(({ id, title }) => (
    <div
      class="primitive-popover"
      id={`primitive-info-${id}`}
      data-primitive-card={id}
      popover="manual"
      role="dialog"
      aria-modal="false"
      aria-labelledby={`primitive-title-${id}`}
      tabindex="-1"
    >
      <svg class="primitive-leader" aria-hidden="true">
        <path />
      </svg>
      <div class="primitive-popover-content">
        <h4 id={`primitive-title-${id}`}>{title}</h4>
        <button class="primitive-close" type="button" aria-label={`Close ${title.toLowerCase()}`}>
          ×
        </button>
        <p>{details[1][title]}</p>
      </div>
    </div>
  ))
}

<script>
  import { setupPrimitiveHotspots } from "./primitive-hotspots";
  setupPrimitiveHotspots();
</script>

<style>
  .primitive-comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
  }
  .primitive-comparison > article {
    min-width: 0;
  }
  .primitive-title {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }
  .primitive-title h3 {
    margin: 0;
    font-size: 28px;
  }
  .primitive-title > span {
    color: #59664f;
    font-size: 12px;
    white-space: nowrap;
  }
  .primitive-comparison > article > p {
    max-inline-size: var(--parallel-copy-width, 100%);
    margin: 0 0 28px;
    font-size: 15px;
    line-height: 1.75;
  }
  .primitive-diagram {
    position: relative;
    padding-top: 44px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #43563c;
  }
  .function-label {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    height: 44px;
    gap: 6px;
    color: #344b31;
    font-size: 12px;
  }
  .function-label i {
    font-family: Georgia, serif;
    font-size: 18px;
  }
  .diagram-hotspot {
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    color: #805014;
    font:
      500 13px/1.5 Inter,
      "Helvetica Neue",
      Arial,
      sans-serif;
    white-space: nowrap;
  }
  .hotspot-label {
    text-decoration: underline;
    text-decoration-color: #b78645;
    text-underline-offset: 4px;
  }
  .diagram-hotspot .hotspot-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid #ae7631;
    border-radius: 50%;
    background: #ffce8a;
    color: #49300f;
    font: 16px/1 var(--font-mono);
    transition:
      transform 0.16s,
      box-shadow 0.16s;
  }
  .diagram-hotspot:hover .hotspot-icon,
  .diagram-hotspot:focus-visible .hotspot-icon,
  .diagram-hotspot[aria-expanded="true"] .hotspot-icon {
    border-color: #8d5410;
    background: #ffce8a;
    color: #49300f;
    transform: scale(1.08);
    box-shadow: 0 0 0 4px #ffce8a33;
  }
  .annotation-footer {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 18px;
    min-height: 62px;
  }
  .actor-annotation {
    margin-left: 100px;
  }
  .function-annotation {
    margin-left: 74px;
    margin-right: 92px;
  }
  .annotation-footer::before,
  .inline-annotation-wire::before {
    content: "";
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ae7631;
  }
  .annotation-footer::before {
    top: -2px;
    left: calc(50% - 2px);
  }
  .annotation-footer::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    height: 18px;
    border-left: 1px solid #b78645;
  }
  .inline-annotation-wire {
    position: relative;
    width: 16px;
    height: 1px;
    background: #b78645;
    flex-shrink: 0;
  }
  .inline-annotation-wire::before {
    top: -1.5px;
    left: -2px;
  }
  .diagram-hotspot.is-introduced .hotspot-icon {
    animation: callout-intro 0.9s ease-out 1;
  }
  @keyframes callout-intro {
    0% {
      transform: scale(0.92);
      box-shadow: 0 0 0 0 #d699424d;
    }
    45% {
      transform: scale(1.08);
      box-shadow: 0 0 0 6px #d6994229;
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 11px #d6994200;
    }
  }
  .primitive-comparison[data-active-topic="actor"] .actor-id,
  .primitive-comparison[data-active-topic="function"] .function-enclosure .primitive-symbol {
    color: #8d5410;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .primitive-comparison[data-active-topic="invocation"] .function-enclosure {
    border-color: #9e6b29;
    box-shadow: 0 0 0 1px #9e6b29;
  }
  .primitive-popover {
    position: fixed;
    left: var(--card-left, 20px);
    top: var(--card-top, 20px);
    width: 336px;
    max-width: calc(100vw - 40px);
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 1px solid #b6c3aa;
    border-radius: 6px;
    background: #fffef7;
    color: #18221d;
    box-shadow: 0 12px 32px #18221d20;
    font:
      14px/1.65 Inter,
      "Helvetica Neue",
      Arial,
      sans-serif;
  }
  .primitive-popover-content {
    position: relative;
    padding: 22px;
  }
  .primitive-popover h4 {
    margin: 0 30px 12px 0;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .primitive-popover p {
    margin: 0;
    color: #4d5b4c;
  }
  .primitive-close {
    position: absolute;
    right: 4px;
    top: 6px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: #43563c;
    font-size: 22px;
    cursor: pointer;
  }
  .primitive-popover :focus-visible,
  .primitive-popover:focus-visible {
    outline: 2px solid #a56b16;
    outline-offset: 3px;
  }
  .primitive-leader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .primitive-leader path {
    fill: none;
    stroke: #9e773e;
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .actor-flow {
    display: grid;
    grid-template-columns: 72px 28px minmax(0, 1fr);
    height: 300px;
  }
  .actor-calls,
  .actor-arrows {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 12px;
  }
  .actor-calls > span {
    white-space: nowrap;
  }
  .primitive-arrow {
    display: block;
    position: relative;
    width: 100%;
    height: 1px;
    background: #718765;
  }
  .primitive-arrow::after {
    content: "";
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid #718765;
    border-right: 1px solid #718765;
    transform: rotate(45deg);
  }
  .primitive-enclosure {
    border: 1px solid #718765;
    border-radius: 5px;
    background: #eaf0e1;
  }
  .actor-enclosure {
    position: relative;
    display: grid;
    place-items: center;
  }
  .primitive-vm-label {
    color: #53654a;
    font-size: 10px;
    line-height: 1.4;
  }
  .actor-enclosure > .primitive-vm-label {
    position: absolute;
    top: 15px;
    left: 16px;
    right: 16px;
    text-align: center;
  }
  .actor-instance {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 8px;
  }
  .primitive-symbol {
    font-family: Georgia, serif;
    color: #4f714a;
    font-size: 56px;
    line-height: 1;
  }
  .actor-instance strong {
    color: #263c2b;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    font-size: 18px;
    font-weight: 500;
  }
  .actor-id {
    color: #53654a;
    font-size: 12px;
  }
  .function-flow {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
    height: 300px;
  }
  .function-call {
    display: grid;
    grid-template-columns: 46px 28px minmax(0, 1fr) 28px 64px;
    align-items: center;
    gap: 0;
  }
  .call-label {
    white-space: nowrap;
  }
  .call-label:last-child {
    padding-left: 6px;
  }
  .function-enclosure {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    text-align: center;
  }
  .function-enclosure .primitive-symbol {
    font-size: 34px;
  }
  .primitive-examples {
    margin-top: 16px;
  }
  .primitive-examples > p {
    margin: 0 0 9px;
    font-size: 11px;
    color: #59664f;
  }
  .primitive-examples ul {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .primitive-examples li {
    display: flex;
    align-items: center;
    padding: 0;
    color: #344b31;
    font-size: 13px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .primitive-examples li + li::before {
    content: "·";
    margin-right: 12px;
    color: #7d8b74;
  }
  @media (max-width: 1100px) {
    .function-annotation {
      margin-left: 60px;
      margin-right: 80px;
    }
    .primitive-comparison {
      gap: 32px;
    }
    .primitive-title {
      gap: 12px;
    }
    .primitive-title h3 {
      font-size: 25px;
    }
    .function-call {
      grid-template-columns: 40px 20px minmax(0, 1fr) 20px 60px;
    }
    .primitive-diagram {
      font-size: 11px;
    }
  }
  @media (max-width: 800px) {
    .primitive-comparison {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .primitive-comparison > article > p {
      font-size: 14px;
    }
  }
  @media (max-width: 600px) {
    .actor-annotation {
      margin-left: 80px;
    }
    .diagram-hotspot {
      font-size: 12px;
    }
    .primitive-popover {
      left: 16px;
      right: 16px;
      top: auto;
      bottom: max(16px, env(safe-area-inset-bottom));
      width: auto;
      max-width: none;
      max-height: calc(50dvh - 16px);
      overflow: auto;
    }
    .primitive-leader {
      display: none;
    }
    .primitive-examples li {
      font-size: 12px;
      letter-spacing: -0.01em;
    }
    .actor-flow {
      grid-template-columns: 58px 22px minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .primitive-comparison .diagram-hotspot .hotspot-icon {
      animation: none;
      transition: none;
      transform: none;
    }
  }
  @media (forced-colors: active) {
    .diagram-hotspot {
      forced-color-adjust: none;
      color: LinkText;
    }
    .hotspot-label {
      text-decoration-color: LinkText;
    }
    .primitive-comparison .diagram-hotspot .hotspot-icon {
      animation: none;
    }
    .diagram-hotspot .hotspot-icon {
      background: Canvas;
      color: CanvasText;
    }
    .diagram-hotspot[aria-expanded="true"] .hotspot-icon {
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
    }
    .diagram-hotspot .hotspot-icon,
    .primitive-popover {
      border-color: CanvasText;
    }
    .primitive-leader path {
      stroke: CanvasText;
    }
    .primitive-enclosure,
    .primitive-examples li {
      border-color: CanvasText;
    }
    .primitive-arrow {
      background: CanvasText;
    }
    .primitive-arrow::after {
      border-color: CanvasText;
    }
  }
</style>
