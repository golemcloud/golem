---
import { metricBar } from "../data/homepage";
import wasmLogo from "../assets/logo/webassembly-white.svg";

const { metrics } = metricBar;
---

<section class="metric-bar-section">
  <div class="metric-bar">
    <div class="metric-strip">
      <div class="wasm-marker">
        <img
          src={wasmLogo.src}
          alt="WebAssembly"
          class="wasm-logo"
          width={wasmLogo.width}
          height={wasmLogo.height}
        />
      </div>
      <div class="metric-divider" aria-hidden="true"></div>
      {
        metrics.map((m) => (
          <div class="metric">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .metric-bar-section {
    padding: 0;
  }
  .metric-bar {
    width: 100%;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .metric-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    padding: 2rem 1.5rem;
    max-width: var(--container);
    margin: 0 auto;
  }
  .metric {
    min-width: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .wasm-marker {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wasm-logo {
    height: 52px;
    width: auto;
    display: block;
    opacity: 0.95;
  }
  .metric-divider {
    display: none;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    line-height: 1.3;
  }
  @media (min-width: 1100px) {
    .metric-strip {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 2.75rem;
      padding: 2.25rem 2rem;
      max-width: none;
    }
    .wasm-marker {
      flex: 0 0 auto;
    }
    .metric-divider {
      display: block;
      flex: 0 0 1px;
      align-self: stretch;
      background: var(--border);
      margin: 0.5rem 0;
    }
    .metric {
      flex: 0 1 auto;
      min-width: 150px;
    }
  }
  @media (max-width: 720px) {
    .metric-strip {
      grid-template-columns: 1fr 1fr;
      padding: 1.75rem 1.25rem;
    }
  }
</style>
