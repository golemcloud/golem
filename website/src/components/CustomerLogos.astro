---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { customerLogos } from "../data/homepage";

// Eager-import every logo so Astro emits optimized variants at build time.
// Look up by filename from the data file.
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logo/*.{png,jpg,jpeg,svg,webp}",
  { eager: true }
);
const logosByFile = Object.fromEntries(
  Object.entries(logoModules).map(([path, mod]) => [path.split("/").pop()!, mod.default])
);

const { label, logos } = customerLogos;
---

<section class="logos-section">
  <div class="logos-bar">
    <div class="logos-strip">
      <p class="logos-label">{label}</p>
      {
        logos.map((logo) => (
          <div class={logo.invertOnDarkBg ? "logo-real logo-invert" : "logo-real"}>
            <Image
              src={logosByFile[logo.filename]}
              alt={logo.alt}
              widths={[140, 280]}
              sizes="140px"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logos-section {
    padding: 0;
  }
  .logos-bar {
    width: 100%;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  .logos-bar::-webkit-scrollbar {
    display: none;
  }
  .logos-strip {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 2.25rem;
    padding: 1.5rem 2rem;
    width: max-content;
    min-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }
  .logos-label {
    flex: 0 0 auto;
    margin: 0;
    padding-right: 1.25rem;
    border-right: 1px solid var(--border);
    white-space: nowrap;
    display: flex;
    align-items: center;
    height: 32px;
    padding-top: 2px;
    box-sizing: border-box;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .logo-real {
    height: 40px;
    width: 140px;
    flex: 0 0 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 150ms;
  }
  .logo-real:hover {
    opacity: 1;
  }
  .logo-real img {
    height: 32px;
    max-width: 130px;
    width: auto;
    object-fit: contain;
    display: block;
  }
  .logo-invert img {
    filter: invert(1);
  }
</style>
