---
import { Image } from "astro:assets";
import { hero } from "../data/homepage";
import heroArt from "../assets/home/golem-hero.png";

const { eyebrow, heading, subhead, ctas, artAlt } = hero;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <a href={eyebrow.href} class="hero-eyebrow"
        >{eyebrow.label} <span aria-hidden="true">→</span></a
      >
      <h1 class="hero-heading">{heading}</h1>
      <p class="hero-subhead">{subhead}</p>
      <div class="hero-ctas">
        <a href={ctas.primary.href} class="btn btn-primary">{ctas.primary.label}</a>
        <a href={ctas.secondary.href} class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          {ctas.secondary.label}
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <Image
        class="hero-art"
        src={heroArt}
        alt={artAlt}
        widths={[560, 1024]}
        sizes="(min-width: 960px) 560px, 90vw"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 4.5rem);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -30%;
    left: 72%;
    width: 900px;
    height: 700px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(245, 176, 62, 0.08), transparent 60%);
    pointer-events: none;
    z-index: -1;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    margin-bottom: 1.1rem;
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }
  .hero-eyebrow:hover {
    color: var(--accent-hover);
    border-color: var(--accent);
  }
  .hero-heading {
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.06;
    margin-bottom: 1.4rem;
    max-width: 14ch;
    background: linear-gradient(to bottom, #ffffff 30%, #b0b0bc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subhead {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 2rem;
    max-width: 560px;
  }
  .hero-ctas {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero-art {
    width: min(560px, 100%);
    height: auto;
    display: block;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 82%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 82%, transparent 100%);
  }
</style>
