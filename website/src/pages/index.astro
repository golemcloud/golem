---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import CustomerLogos from "../components/CustomerLogos.astro";
import CoreVm from "../components/CoreVm.astro";
import MetricBar from "../components/MetricBar.astro";
import Chapter from "../components/Chapter.astro";
import CustomerStories from "../components/CustomerStories.astro";
import Deployment from "../components/Deployment.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { meta } from "../data/homepage";
---

<BaseLayout title={meta.title} description={meta.description}>
  <Nav />
  <main>
    <Hero />
    <CustomerLogos />
    <CoreVm />
    <MetricBar />
    <Chapter kind="agents" />
    <Chapter kind="tools" />
    <Chapter kind="artifacts" />
    <hr class="divider" />
    <CustomerStories />
    <Deployment />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
