---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageIntro from "../components/PageIntro.astro";
import {
  meta,
  hero,
  featuredCase,
  jobs,
  tools,
  fit,
  experiment,
  accessibility,
} from "../data/use-cases";

const navigation = [featuredCase, ...jobs];
---

<BaseLayout title={meta.title} description={meta.description}>
  <a class="skip-link" href="#main-content">{accessibility.skip}</a>
  <Nav />
  <main class="use-cases-page" id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="page-title">
      <div class="container">
        <PageIntro {...hero} headingId="page-title" />
        <nav class="job-navigation" aria-label={hero.navigationLabel}>
          <ul>
            {
              navigation.map((job) => (
                <li>
                  <a class="case-card" href={`#${job.id}`} aria-labelledby={`${job.id}-overview`}>
                    <h2 id={`${job.id}-overview`}>{job.navLabel}</h2>
                    <p>{job.example}</p>
                    <span aria-hidden="true">{hero.exploreLabel} →</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>

    <section class="featured-section" aria-labelledby={featuredCase.id}>
      <div class="container">
        <div class="section-intro">
          <h2 id={featuredCase.id} tabindex="-1">{featuredCase.title}</h2>
          <p>{featuredCase.pain}</p>
        </div>
        <div class="worked-example">
          <h3 class="example-title">{featuredCase.exampleTitle}</h3>
          <p class="runtime-copy">{featuredCase.runtime}</p>
          <p class="tool-choice">{featuredCase.toolChoice}</p>
          <div class="example-parts">
            {
              featuredCase.parts.map((part) => (
                <div class="example-part">
                  <h4>{part.title}</h4>
                  <p>{part.body}</p>
                </div>
              ))
            }
          </div>
          <aside class="recovery" aria-labelledby="recovery-title">
            <h4 id="recovery-title">{featuredCase.recoveryLabel}</h4>
            <p>{featuredCase.recovery}</p>
          </aside>
        </div>
        <p class="integration-note">
          <strong>{featuredCase.integrationLabel}.</strong>
          {featuredCase.integration}
        </p>
        <div class="documentation-links">
          {
            featuredCase.links.map((link) => (
              <a href={link.href}>
                {link.label}
                <span aria-hidden="true"> →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <div class="job-sections container">
      {
        jobs.map((job) => (
          <section class="job" aria-labelledby={job.id}>
            <div class="job-intro">
              <h2 id={job.id} tabindex="-1">
                {job.title}
              </h2>
              <p>{job.pain}</p>
            </div>
            <div class="job-detail">
              <p class="application-example">{job.example}</p>
              <p>{job.help}</p>
              <div class="documentation-links">
                {job.links.map((link) => (
                  <a href={link.href}>
                    {link.label}
                    <span aria-hidden="true"> →</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </div>

    <section class="tools-section" aria-labelledby="tools-title">
      <div class="container">
        <div class="tools-copy">
          <h2 id="tools-title">{tools.title}</h2>
          <p>{tools.body}</p>
          <div class="documentation-links">
            <a href={tools.link.href}>{tools.link.label}<span aria-hidden="true"> →</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="fit-section" aria-labelledby="fit-title">
      <div class="container">
        <h2 id="fit-title">{fit.title}</h2>
        <div class="fit-grid">
          {
            fit.items.map((item) => (
              <div class="fit-item">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="experiment" aria-labelledby="experiment-title">
      <div class="container">
        <div class="experiment-copy">
          <h2 id="experiment-title">{experiment.title}</h2>
          <p class="experiment-intro">{experiment.intro}</p>
          {experiment.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <div class="actions">
            {
              experiment.actions.map((link, index) => (
                <a
                  class:list={["btn", index === 0 ? "btn-primary" : "btn-secondary"]}
                  href={link.href}
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 6px;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  .use-cases-page :global(a:focus-visible),
  [tabindex="-1"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
    border-radius: 3px;
    transition: none;
  }
  [id] {
    scroll-margin-top: 5.5rem;
  }
  h2 {
    font-size: clamp(1.6rem, 2.7vw, 2.05rem);
    margin-bottom: 1rem;
    text-wrap: balance;
  }
  p {
    line-height: 1.65;
  }
  .hero {
    padding: 0 0 3.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .actions .btn {
    white-space: normal;
  }
  .job-navigation ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .case-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    color: var(--text);
  }
  .case-card:hover {
    border-color: var(--accent-border);
  }
  .case-card h2 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    text-wrap: initial;
  }
  .case-card p {
    flex: 1;
    margin-bottom: 1.25rem;
  }
  .case-card span {
    color: var(--accent);
    font-size: 0.9rem;
  }
  .featured-section {
    border-block: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 3rem 0;
  }
  .section-intro {
    max-width: 78ch;
  }
  .worked-example {
    margin-top: 2rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .example-title {
    font-size: 1.15rem;
    line-height: 1.4;
    margin-bottom: 1rem;
  }
  .runtime-copy {
    max-width: 85ch;
  }
  .tool-choice {
    margin-top: 1rem;
    margin-bottom: 1.75rem;
    font-size: 0.94rem;
  }
  .example-parts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    gap: 1.5rem;
  }
  .example-part {
    border-top: 1px solid var(--border-strong);
    padding-top: 1rem;
  }
  .example-parts h4 {
    font-size: 1rem;
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }
  .example-parts p {
    font-size: 0.94rem;
  }
  .recovery {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-elevated);
  }
  .recovery h4 {
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .recovery p {
    font-size: 0.94rem;
    max-width: 96ch;
  }
  .integration-note {
    max-width: 85ch;
    margin-top: 1.5rem;
  }
  .documentation-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1rem;
  }
  .documentation-links a {
    display: inline-block;
    padding-block: 0.4rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--accent-border);
  }
  .documentation-links a:hover {
    text-decoration-color: currentColor;
  }
  .job {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    border-bottom: 1px solid var(--border);
    padding: 2.75rem 0;
  }
  .job:last-child {
    border-bottom: 0;
  }
  .job h2 {
    font-size: clamp(1.4rem, 2.2vw, 1.7rem);
  }
  .application-example {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
    border-left: 2px solid var(--accent-border);
    padding-left: 1rem;
  }
  .tools-section {
    padding: 2.75rem 0;
    border-top: 1px solid var(--border);
  }
  .tools-copy {
    max-width: 85ch;
  }
  .integration-note strong {
    color: var(--text);
  }
  .fit-section {
    padding: 3rem 0;
    background: var(--bg-elevated);
    border-block: 1px solid var(--border);
  }
  .fit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 3rem;
    margin-top: 1.75rem;
  }
  .fit-item h3 {
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }
  .fit-item p {
    font-size: 0.95rem;
  }
  .experiment {
    padding: 3.5rem 0;
  }
  .experiment-copy {
    max-width: 80ch;
  }
  .experiment p + p {
    margin-top: 1rem;
  }
  .experiment-intro {
    color: var(--text);
  }
  @media (max-width: 960px) {
    .example-parts,
    .fit-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .example-parts,
    .job,
    .fit-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .job {
      gap: 1.25rem;
      padding: 2.25rem 0;
    }
    .documentation-links {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-bottom: 2.5rem;
    }
    .job-navigation ul {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-card {
      padding: 1.35rem;
    }
  }
</style>
