---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageIntro from "../components/PageIntro.astro";
import {
  meta,
  hero,
  offers,
  previewNotice,
  resources,
  budget,
  deployment,
  faq,
  closing,
} from "../data/cloud";
---

<BaseLayout title={meta.title} description={meta.description}>
  <Nav />
  <main>
    <section class="pricing-intro" aria-labelledby="pricing-title">
      <div class="container">
        <PageIntro {...hero} headingId="pricing-title" />
        <div class="offer-grid">
          {
            offers.map((offer) => (
              <article
                class:list={["offer-card", { "offer-card-featured": offer.emphasized }]}
                aria-labelledby={`${offer.id}-title`}
              >
                <div class="offer-topline">
                  <>
                    <h2 id={`${offer.id}-title`}>{offer.name}</h2>
                    <span class:list={["status", { "status-live": offer.emphasized }]}>
                      {offer.badge}
                    </span>
                  </>
                </div>
                <div class="offer-price">{offer.price}</div>
                <p class="price-note">{offer.priceNote}</p>
                <p class="offer-description">{offer.description}</p>
                <ul class="offer-features">
                  {offer.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
                <p class="offer-note">{offer.note}</p>
                {offer.id === "preview" && (
                  <aside class="preview-notice" aria-label="Developer Preview conditions">
                    <strong>{previewNotice.heading}.</strong>
                    <p>
                      {previewNotice.body}{" "}
                      <a href={previewNotice.link.href}>
                        {previewNotice.link.label} <span aria-hidden="true">→</span>
                      </a>
                    </p>
                  </aside>
                )}
                <a
                  href={offer.cta.href}
                  class:list={[
                    "btn",
                    "offer-cta",
                    offer.emphasized ? "btn-primary" : "btn-secondary",
                  ]}
                >
                  {offer.cta.label} <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="resource-section section" aria-labelledby="resource-title">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">{resources.eyebrow}</span><h2 id="resource-title">
            {resources.heading}
          </h2><p>{resources.lead}</p>
        </header>
        <dl class="resource-list">
          {
            resources.items.map((resource) => (
              <div class="resource-row">
                <>
                  <dt>
                    <>
                      <span>{resource.name}</span>
                      <span class="resource-unit">{resource.unit}</span>
                    </>
                  </dt>
                  <dd>{resource.description}</dd>
                </>
              </div>
            ))
          }
        </dl>
        <div class="state-grid">
          {
            resources.states.map((state) => (
              <div class="state-note">
                <>
                  <h3>{state.label}</h3>
                  <p>{state.body}</p>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="budget-section section" aria-labelledby="budget-title">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">{budget.eyebrow}</span><h2 id="budget-title">{budget.heading}</h2><p
          >
            {budget.lead}
          </p>
        </header>
        <ol class="budget-steps">
          {
            budget.steps.map((step) => (
              <li>
                <>
                  <span class="step-number" aria-hidden="true">
                    {step.number}
                  </span>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </>
              </li>
            ))
          }
        </ol>
        <aside class="usage-example" aria-label={budget.example.heading}>
          <h3>{budget.example.heading}</h3>
          <p class="usage-calculation">{budget.example.calculation}</p>
          <p>{budget.example.body}</p>
        </aside>
        <p class="external-costs">{budget.externalCosts}</p>
        <div class="section-actions">
          <a href={budget.cta.href} class="btn btn-primary"
            >{budget.cta.label} <span aria-hidden="true">→</span></a
          ><a href={budget.secondary.href} class="text-link"
            >{budget.secondary.label} <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>
    <section class="deployment-section section" aria-labelledby="deployment-title">
      <div class="container">
        <h2 id="deployment-title">{deployment.heading}</h2><div class="deployment-grid">
          {
            deployment.options.map((option) => (
              <article>
                <>
                  <h3>{option.title}</h3>
                  <p>{option.body}</p>
                  <a href={option.link.href}>
                    {option.link.label} <span aria-hidden="true">→</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="faq-section section" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <h2 id="faq-title">{faq.heading}</h2><div class="faq-list">
          {
            faq.items.map((item) => (
              <details>
                <>
                  <summary>
                    {item.question}
                    <span class="faq-marker" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p>{item.answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>
    <section class="closing section" aria-labelledby="closing-title">
      <div class="container">
        <h2 id="closing-title">{closing.heading}</h2><p>{closing.body}</p><div
          class="section-actions"
        >
          <a href={closing.primary.href} class="btn btn-primary"
            >{closing.primary.label} <span aria-hidden="true">→</span></a
          ><a href={closing.secondary.href} class="btn btn-secondary">{closing.secondary.label}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .pricing-intro {
    padding: 0 0 3.5rem;
  }
  .eyebrow {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .offer-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    min-width: 0;
  }
  .offer-card-featured {
    border-color: var(--accent-border);
    background:
      linear-gradient(140deg, rgba(245, 176, 62, 0.045), transparent 60%), var(--bg-elevated);
  }
  .offer-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .offer-topline h2 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .status {
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-secondary);
    padding: 0.2rem 0.6rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .status-live {
    border-color: var(--accent-border);
    color: var(--accent);
    background: var(--accent-dim);
  }
  .offer-price {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .price-note {
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin: 0.35rem 0 1.2rem;
  }
  .offer-description {
    color: var(--text-secondary);
    max-width: 48ch;
  }
  .offer-features {
    list-style: none;
    margin: 1.25rem 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  .offer-features li {
    position: relative;
    padding-left: 1.25rem;
  }
  .offer-features li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }
  .offer-note {
    color: var(--text-secondary);
    font-size: 0.82rem;
    margin-top: auto;
    margin-bottom: 1.25rem;
  }
  .offer-cta {
    align-self: flex-start;
  }
  .preview-notice {
    display: block;
    border-top: 1px solid var(--border);
    padding: 0.85rem 0 0;
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.65;
  }
  .preview-notice strong {
    flex: 0 0 auto;
    color: var(--text);
    font-weight: 500;
  }
  .preview-notice p {
    max-width: 850px;
    margin-top: 0.3rem;
  }
  .preview-notice a {
    white-space: nowrap;
  }
  .section {
    padding: 3.75rem 0;
    border-top: 1px solid var(--border);
  }
  .section-header {
    max-width: 760px;
    margin-bottom: 1.75rem;
  }
  h2 {
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .section-header > p {
    margin-top: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .resource-list {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .resource-row {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
    gap: 2rem;
    padding: 1.2rem 1.5rem;
  }
  .resource-row + .resource-row {
    border-top: 1px solid var(--border);
  }
  .resource-row dt {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
  }
  .resource-unit {
    flex-shrink: 0;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .resource-row dd {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .state-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .state-note {
    padding-left: 1rem;
    border-left: 2px solid var(--accent-border);
  }
  h3 {
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.012em;
    line-height: 1.4;
  }
  .state-note p {
    margin-top: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .budget-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .step-number {
    display: block;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }
  .budget-steps p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-top: 0.6rem;
  }
  .usage-example {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
  }
  .usage-example > p {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .usage-example .usage-calculation {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .external-costs {
    margin-top: 1.75rem;
    max-width: 800px;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .section-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .text-link {
    font-size: 0.92rem;
  }
  .deployment-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  .deployment-grid p {
    margin: 0.6rem 0 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 52ch;
    font-size: 0.92rem;
  }
  .deployment-grid a {
    font-size: 0.9rem;
  }
  .faq-layout {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: 3rem;
  }
  .faq-list {
    border-top: 1px solid var(--border);
  }
  details {
    border-bottom: 1px solid var(--border);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.15rem 0;
    cursor: pointer;
    font-size: 0.96rem;
    font-weight: 500;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-marker {
    flex-shrink: 0;
    color: var(--accent);
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 150ms;
  }
  details[open] .faq-marker {
    transform: rotate(45deg);
  }
  details > p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.75;
    padding: 0 2rem 1.25rem 0;
  }
  summary:hover {
    color: var(--accent);
  }
  summary:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
    border-radius: 3px;
  }
  .closing {
    background: radial-gradient(ellipse at 25% 100%, var(--accent-dim), transparent 60%);
    padding-bottom: 4.5rem;
  }
  .closing p {
    margin-top: 0.8rem;
    color: var(--text-secondary);
  }
  @media (max-width: 800px) {
    .resource-row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
    .budget-steps {
      gap: 1.4rem;
    }
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .preview-notice {
      display: block;
    }
    .preview-notice p {
      margin-top: 0.3rem;
    }
  }
  @media (max-width: 600px) {
    .pricing-intro {
      padding-bottom: 2.5rem;
    }
    .offer-grid,
    .state-grid,
    .budget-steps,
    .deployment-grid {
      grid-template-columns: 1fr;
    }
    .offer-card {
      padding: 1.35rem;
    }
    .offer-topline {
      margin-bottom: 1.1rem;
    }
    .offer-description {
      font-size: 0.94rem;
    }
    .offer-features {
      font-size: 0.88rem;
    }
    .offer-note {
      font-size: 0.8rem;
    }
    .section {
      padding: 2.75rem 0;
    }
    .resource-row {
      padding: 1rem;
    }
    .resource-row dt {
      flex-direction: column;
      gap: 0.2rem;
    }
    .resource-unit {
      font-size: 0.76rem;
    }
    .state-grid,
    .deployment-grid {
      gap: 1.5rem;
    }
    .budget-steps {
      gap: 1.6rem;
    }
    .section-actions {
      align-items: flex-start;
    }
    details > p {
      padding-right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-marker {
      transition: none;
    }
  }
</style>
