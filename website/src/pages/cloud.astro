---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageIntro from "../components/PageIntro.astro";
import {
  meta,
  hero,
  offers,
  planNotes,
  overage,
  resources,
  budget,
  deployment,
  faq,
  closing,
} from "../data/cloud";
---

<BaseLayout title={meta.title} description={meta.description}>
  <Nav />
  <main>
    <section class="pricing-intro" aria-labelledby="pricing-title">
      <div class="container">
        <PageIntro {...hero} headingId="pricing-title" />
        <div class="offer-grid">
          {
            offers.map((offer) => (
              <article
                class:list={["offer-card", { "offer-card-featured": offer.emphasized }]}
                aria-labelledby={`${offer.id}-title`}
              >
                <h2 id={`${offer.id}-title`} class="offer-name">
                  {offer.name}
                </h2>
                <p class="offer-price">
                  {offer.price}
                  <span class="offer-period">{offer.period}</span>
                </p>
                <p class="price-note">{offer.priceNote}</p>
                <p class="offer-description">{offer.description}</p>
                <h3 class="offer-label">Included each month</h3>
                <ul class="offer-features">
                  {offer.included.map((item) => (
                    <li>
                      <span class="included-amount">{item.amount}</span> {item.label}
                    </li>
                  ))}
                </ul>
                <div class="offer-run-out">
                  <h3 class="offer-label">When an amount runs out</h3>
                  <p>{offer.runOut}</p>
                </div>
                {offer.ctaNote && <p class="offer-cta-note">{offer.ctaNote}</p>}
                <a
                  href={offer.cta.href}
                  class:list={[
                    "btn",
                    "offer-cta",
                    offer.emphasized ? "btn-primary" : "btn-secondary",
                  ]}
                >
                  {offer.cta.label} <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
        <div class="plan-notes">
          {
            planNotes.map((note) => (
              <div class="state-note">
                <h2 class="note-heading">{note.heading}</h2>
                <p>{note.body}</p>
                <a href={note.link.href}>
                  {note.link.label} <span aria-hidden="true">→</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="overage-section section" aria-labelledby="overage-title">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">{overage.eyebrow}</span><h2 id="overage-title">
            {overage.heading}
          </h2><p>{overage.lead}</p>
        </header>
        <table class="price-table" role="table">
          <caption class="sr-only">{overage.caption}</caption>
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader" class="price-table-corner">{overage.rowHeader}</th
              >
              {
                overage.currencies.map((currency) => (
                  <th scope="col" role="columnheader">
                    <span class="currency-code">{currency.code}</span>
                    <span class="currency-tax">{currency.tax}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              overage.rows.map((row) => (
                <tr role="row">
                  <th scope="row" role="rowheader">
                    <span>{row.name}</span>
                    <span class="resource-unit">{row.unit}</span>
                  </th>
                  {row.prices.map((price) => (
                    <td role="cell">{price}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="table-note">{overage.note}</p>
      </div>
    </section>
    <section class="resource-section section" aria-labelledby="resource-title">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">{resources.eyebrow}</span><h2 id="resource-title">
            {resources.heading}
          </h2><p>{resources.lead}</p>
        </header>
        <dl class="resource-list">
          {
            resources.items.map((resource) => (
              <div class="resource-row">
                <>
                  <dt>
                    <>
                      <span>{resource.name}</span>
                      <span class="resource-unit">{resource.unit}</span>
                    </>
                  </dt>
                  <dd>{resource.description}</dd>
                </>
              </div>
            ))
          }
        </dl>
        <div class="state-grid">
          {
            resources.states.map((state) => (
              <div class="state-note">
                <>
                  <h3>{state.label}</h3>
                  <p>{state.body}</p>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="budget-section section" aria-labelledby="budget-title">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">{budget.eyebrow}</span><h2 id="budget-title">{budget.heading}</h2><p
          >
            {budget.lead}
          </p>
        </header>
        <ol class="budget-steps">
          {
            budget.steps.map((step) => (
              <li>
                <>
                  <span class="step-number" aria-hidden="true">
                    {step.number}
                  </span>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </>
              </li>
            ))
          }
        </ol>
        <aside class="usage-example" aria-label={budget.example.heading}>
          <h3>{budget.example.heading}</h3>
          <p class="usage-calculation">{budget.example.calculation}</p>
          <p>{budget.example.body}</p>
        </aside>
        <p class="external-costs">{budget.externalCosts}</p>
        <div class="section-actions">
          <a href={budget.cta.href} class="btn btn-primary"
            >{budget.cta.label} <span aria-hidden="true">→</span></a
          ><a href={budget.secondary.href} class="text-link"
            >{budget.secondary.label} <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>
    <section class="deployment-section section" aria-labelledby="deployment-title">
      <div class="container">
        <h2 id="deployment-title">{deployment.heading}</h2><div class="deployment-grid">
          {
            deployment.options.map((option) => (
              <article>
                <>
                  <h3>{option.title}</h3>
                  <p>{option.body}</p>
                  <a href={option.link.href}>
                    {option.link.label} <span aria-hidden="true">→</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="faq-section section" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <h2 id="faq-title">{faq.heading}</h2><div class="faq-list">
          {
            faq.items.map((item) => (
              <details>
                <>
                  <summary>
                    {item.question}
                    <span class="faq-marker" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p>{item.answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>
    <section class="closing section" aria-labelledby="closing-title">
      <div class="container">
        <h2 id="closing-title">{closing.heading}</h2><p>{closing.body}</p><div
          class="section-actions"
        >
          <a href={closing.primary.href} class="btn btn-primary"
            >{closing.primary.label} <span aria-hidden="true">→</span></a
          ><a href={closing.secondary.href} class="btn btn-secondary">{closing.secondary.label}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .pricing-intro {
    padding: 0 0 3.5rem;
  }
  .eyebrow {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .offer-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    min-width: 0;
  }
  .offer-card-featured {
    border-color: var(--accent-border);
    background:
      linear-gradient(140deg, rgba(245, 176, 62, 0.045), transparent 60%), var(--bg-elevated);
  }
  .offer-name {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 1.1rem;
  }
  .offer-price {
    color: var(--text);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .offer-period {
    margin-left: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .price-note {
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin: 0.45rem 0 1.2rem;
    max-width: 48ch;
  }
  .offer-description {
    color: var(--text-secondary);
    max-width: 48ch;
  }
  .offer-label {
    margin-top: 1.4rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .offer-features {
    list-style: none;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  .offer-features li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-secondary);
  }
  .included-amount {
    color: var(--text);
    font-weight: 550;
  }
  .offer-features li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }
  .offer-run-out {
    margin-bottom: 1.5rem;
  }
  .offer-run-out p {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
    max-width: 52ch;
  }
  .offer-cta {
    align-self: flex-start;
    margin-top: auto;
  }
  .offer-cta-note {
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .plan-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  .note-heading {
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.012em;
    line-height: 1.4;
  }
  .plan-notes a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .price-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-elevated);
    font-size: 0.92rem;
  }
  .price-table th,
  .price-table td {
    padding: 1.05rem 1.5rem;
    text-align: left;
    vertical-align: baseline;
  }
  .price-table thead th {
    border-bottom: 1px solid var(--border);
    font-weight: 500;
  }
  .price-table tbody tr + tr > * {
    border-top: 1px solid var(--border);
  }
  .price-table-corner {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }
  .currency-code {
    display: block;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .currency-tax {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 400;
  }
  .price-table tbody th {
    font-weight: 500;
  }
  .price-table tbody th .resource-unit {
    display: block;
    margin-top: 0.15rem;
  }
  .price-table td {
    color: var(--text);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .table-note {
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .section {
    padding: 3.75rem 0;
    border-top: 1px solid var(--border);
  }
  .section-header {
    max-width: 760px;
    margin-bottom: 1.75rem;
  }
  h2 {
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .section-header > p {
    margin-top: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .resource-list {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .resource-row {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
    gap: 2rem;
    padding: 1.2rem 1.5rem;
  }
  .resource-row + .resource-row {
    border-top: 1px solid var(--border);
  }
  .resource-row dt {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
  }
  .resource-unit {
    flex-shrink: 0;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .resource-row dd {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .state-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .state-note {
    padding-left: 1rem;
    border-left: 2px solid var(--accent-border);
  }
  h3 {
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.012em;
    line-height: 1.4;
  }
  .state-note p {
    margin-top: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .budget-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .step-number {
    display: block;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }
  .budget-steps p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-top: 0.6rem;
  }
  .usage-example {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
  }
  .usage-example > p {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .usage-example .usage-calculation {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .external-costs {
    margin-top: 1.75rem;
    max-width: 800px;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .section-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .text-link {
    font-size: 0.92rem;
  }
  .deployment-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  .deployment-grid p {
    margin: 0.6rem 0 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 52ch;
    font-size: 0.92rem;
  }
  .deployment-grid a {
    font-size: 0.9rem;
  }
  .faq-layout {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: 3rem;
  }
  .faq-list {
    border-top: 1px solid var(--border);
  }
  details {
    border-bottom: 1px solid var(--border);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.15rem 0;
    cursor: pointer;
    font-size: 0.96rem;
    font-weight: 500;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-marker {
    flex-shrink: 0;
    color: var(--accent);
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 150ms;
  }
  details[open] .faq-marker {
    transform: rotate(45deg);
  }
  details > p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.75;
    padding: 0 2rem 1.25rem 0;
  }
  summary:hover {
    color: var(--accent);
  }
  summary:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
    border-radius: 3px;
  }
  .closing {
    background: radial-gradient(ellipse at 25% 100%, var(--accent-dim), transparent 60%);
    padding-bottom: 4.5rem;
  }
  .closing p {
    margin-top: 0.8rem;
    color: var(--text-secondary);
  }
  @media (max-width: 800px) {
    .resource-row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
    .budget-steps {
      gap: 1.4rem;
    }
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .price-table th,
    .price-table td {
      padding: 0.95rem 1rem;
    }
  }
  @media (max-width: 600px) {
    .pricing-intro {
      padding-bottom: 2.5rem;
    }
    .offer-grid,
    .plan-notes,
    .state-grid,
    .budget-steps,
    .deployment-grid {
      grid-template-columns: 1fr;
    }
    .offer-card {
      padding: 1.35rem;
    }
    .offer-description {
      font-size: 0.94rem;
    }
    .offer-features {
      font-size: 0.88rem;
    }
    .plan-notes {
      gap: 1.5rem;
    }
    .price-table,
    .price-table thead,
    .price-table tbody {
      display: block;
    }
    .price-table thead tr,
    .price-table tbody tr {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .price-table thead .price-table-corner {
      display: none;
    }
    .price-table th,
    .price-table td {
      padding: 0.8rem 1rem;
    }
    .price-table tbody th {
      grid-column: 1 / -1;
      padding-bottom: 0.2rem;
    }
    .price-table tbody td {
      padding-top: 0.35rem;
    }
    .price-table tbody tr + tr > * {
      border-top: 0;
    }
    .price-table tbody tr + tr {
      border-top: 1px solid var(--border);
    }
    .section {
      padding: 2.75rem 0;
    }
    .resource-row {
      padding: 1rem;
    }
    .resource-row dt {
      flex-direction: column;
      gap: 0.2rem;
    }
    .resource-unit {
      font-size: 0.76rem;
    }
    .state-grid,
    .deployment-grid {
      gap: 1.5rem;
    }
    .budget-steps {
      gap: 1.6rem;
    }
    .section-actions {
      align-items: flex-start;
    }
    details > p {
      padding-right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-marker {
      transition: none;
    }
  }
</style>
