diff --git a/src/api/pushRefs.js b/src/api/pushRefs.js
new file mode 100644
index 0000000..62fcad1
--- /dev/null
+++ b/src/api/pushRefs.js
@@ -0,0 +1,127 @@
+import { _isDescendent } from '../commands/isDescendent.js'
+import { _pack } from '../commands/pack.js'
+import { GitRemoteHTTP } from '../managers/GitRemoteHTTP.js'
+import { GitShallowManager } from '../managers/GitShallowManager.js'
+import { FileSystem } from '../models/FileSystem.js'
+import { GitAnnotatedTag } from '../models/GitAnnotatedTag.js'
+import { GitCommit } from '../models/GitCommit.js'
+import { GitPktLine } from '../models/GitPktLine.js'
+import { GitTree } from '../models/GitTree.js'
+import { _readObject } from '../storage/readObject.js'
+import { parseReceivePackResponse } from '../wire/parseReceivePackResponse.js'
+import { writeReceivePackRequest } from '../wire/writeReceivePackRequest.js'
+
+/**
+ * Send all ref updates in one receive-pack exchange. Reference selection and
+ * lease checks use the advertisement whose old OIDs are sent to the server.
+ * No local references or configuration are changed by this operation.
+ * @param {object} args
+ * @param {FsClient} args.fs
+ * @param {HttpClient} args.http
+ * @param {string} args.gitdir
+ * @param {string} args.url
+ * @param {(refs: Map<string, string>) => Promise<Array<{ref: string, oid: string, force: boolean}>>} args.plan
+ * @param {(ref: string, oldoid: string) => Promise<void>} [args.onPrePush]
+ * @param {boolean} [args.atomic]
+ * @param {object} [args.cache]
+ */
+export async function pushRefs({ fs, http, gitdir, url, plan, onPrePush, atomic = false, cache = {} }) {
+  fs = new FileSystem(fs)
+  const zero = '0000000000000000000000000000000000000000'
+  const headers = {}
+  const remote = await GitRemoteHTTP.discover({ http, url, headers, service: 'git-receive-pack', protocolVersion: 1 })
+  if (!remote.capabilities.has('report-status')) throw new Error('Remote does not support receive-pack report-status')
+  if (atomic && !remote.capabilities.has('atomic')) throw new Error('Remote does not support atomic push')
+  for (const oid of remote.refs.values()) {
+    if (!/^[0-9a-f]{40}$/.test(oid)) throw new Error('Invalid receive-pack object ID')
+  }
+  const updates = await plan(remote.refs)
+  const results = []
+  const triplets = []
+  const destinations = new Set()
+  async function peel(oid) {
+    let object = await _readObject({ fs, cache, gitdir, oid })
+    while (object.type === 'tag') {
+      oid = GitAnnotatedTag.from(object.object).headers().object
+      object = await _readObject({ fs, cache, gitdir, oid })
+    }
+    return { oid, type: object.type }
+  }
+  for (const update of updates) {
+    if (destinations.has(update.ref)) throw new Error(`Duplicate push destination: ${update.ref}`)
+    destinations.add(update.ref)
+    const oldoid = remote.refs.get(update.ref) || zero
+    let error
+    try {
+      if (update.oid === zero && oldoid === zero) throw new Error('Remote reference does not exist')
+      if (onPrePush && update.oid !== oldoid) await onPrePush(update.ref, oldoid)
+      if (update.oid === zero && !remote.capabilities.has('delete-refs')) throw new Error('Remote does not support deleting references')
+      if (update.oid !== zero && update.ref.startsWith('refs/heads/')) {
+        const object = await _readObject({ fs, cache, gitdir, oid: update.oid })
+        if (object.type !== 'commit') throw new Error('Branch must point to a commit')
+      }
+      if (oldoid !== zero && update.oid !== zero && oldoid !== update.oid && !update.force) {
+        if (update.ref.startsWith('refs/tags/')) throw new Error('Tag already exists')
+        if (!update.ref.startsWith('refs/tags/')) {
+          let fastForward = false
+          try {
+            const next = await peel(update.oid)
+            const previous = await peel(oldoid)
+            fastForward = next.type === 'commit' && previous.type === 'commit' &&
+              (next.oid === previous.oid || await _isDescendent({ fs, cache, gitdir, oid: next.oid, ancestor: previous.oid, depth: -1 }))
+          } catch (cause) {
+            if (cause.code !== 'NotFoundError') throw cause
+          }
+          if (!fastForward) throw new Error('Non-fast-forward push rejected; fetch first')
+        }
+      }
+    } catch (cause) {
+      error = cause.message
+    }
+    const result = { ref: update.ref, oid: update.oid, oldoid, ok: !error, error, upToDate: oldoid === update.oid }
+    results.push(result)
+    if (!error && !result.upToDate) triplets.push({ fullRef: update.ref, oid: update.oid, oldoid })
+  }
+  if (atomic && results.some(result => !result.ok)) {
+    for (const result of results) if (result.ok && !result.upToDate) {
+      result.ok = false
+      result.error = 'Atomic push failed preflight'
+    }
+    return results
+  }
+  if (!triplets.length) return results
+  const shallows = await GitShallowManager.read({ fs, gitdir })
+  const objects = new Set()
+  const finish = new Set(remote.refs.values())
+  const queue = triplets.filter(triplet => triplet.oid !== zero).map(triplet => triplet.oid)
+  while (queue.length) {
+    const oid = queue.pop()
+    if (objects.has(oid) || finish.has(oid)) continue
+    const { type, object } = await _readObject({ fs, cache, gitdir, oid })
+    objects.add(oid)
+    if (type === 'commit') {
+      const commit = GitCommit.from(object).headers()
+      queue.push(commit.tree)
+      if (!shallows.has(oid)) queue.push(...commit.parent)
+    } else if (type === 'tree') {
+      for (const entry of GitTree.from(object)) if (entry.type !== 'commit') queue.push(entry.oid)
+    } else if (type === 'tag') queue.push(GitAnnotatedTag.from(object).headers().object)
+  }
+  const capabilities = ['report-status', ...(atomic ? ['atomic'] : [])]
+  const command = await writeReceivePackRequest({ capabilities, triplets })
+  const pack = triplets.some(triplet => triplet.oid !== zero) ? await _pack({ fs, cache, gitdir, oids: [...objects] }) : []
+  const response = await GitRemoteHTTP.connect({ http, url, headers, auth: remote.auth, service: 'git-receive-pack', body: [
+    ...[...shallows].map(oid => GitPktLine.encode(`shallow ${oid}\n`)),
+    ...command, ...pack,
+  ] })
+  const status = await parseReceivePackResponse(response.body)
+  for (const ref of Object.keys(status.refs)) if (!destinations.has(ref)) throw new Error('Receive-pack reported an unrequested reference')
+  for (const result of results) {
+    if (!result.ok || result.upToDate) continue
+    const accepted = status.refs[result.ref]
+    if (status.ok && !accepted) throw new Error(`Receive-pack omitted status for ${result.ref}`)
+    result.ok = status.ok && accepted.ok
+    result.error = status.error || accepted?.error || undefined
+  }
+  return results
+}
