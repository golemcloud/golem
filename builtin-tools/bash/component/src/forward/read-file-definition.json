   {
    "name": "read-file",
    "aliases": [],
    "doc": {
     "summary": "Reads a page from a known text file. Lines are 1-based and `end_line` is inclusive. Omit both bounds to read from the beginning. A call examines at most 64 KiB and 200 lines, so a distant start or oversized line can produce an empty or partial page. When `next_cursor` is present, call again with the same bounds and that cursor. The path must be supplied by the caller; this tool does not discover or list files.",
     "description": "",
     "examples": []
    },
