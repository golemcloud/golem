  "detectors": [
    [
      "syntax.quote.single",
      "'"
    ],
    [
      "syntax.quote.double",
      "\""
    ],
    [
      "syntax.quote.ansi-c",
      "\\$'"
    ],
    [
      "syntax.quote.escape",
      "\\\\[^\\n]"
    ],
    [
      "syntax.comment",
      "(^|\\s)#[^!{]"
    ],
    [
      "compound.pipeline",
      "[^|]\\|[^|]"
    ],
    [
      "compound.pipeline.negate",
      "(^|[;&|(]\\s*|(?<![\\p{L}\\p{N}_])then\\s+|(?<![\\p{L}\\p{N}_])do\\s+)!\\s"
    ],
    [
      "compound.list",
      "&&|\\|\\|"
    ],
    [
      "compound.group",
      "(^|[;&|(]\\s*)\\{\\s"
    ],
    [
      "compound.subshell",
      "(^|[;&|]\\s*)\\((?!\\()"
    ],
    [
      "compound.if",
      "(?<![\\p{L}\\p{N}_])if(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])then(?![\\p{L}\\p{N}_])"
    ],
    [
      "compound.case",
      "(?<![\\p{L}\\p{N}_])case(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])in(?![\\p{L}\\p{N}_])"
    ],
    [
      "compound.case.fallthrough",
      ";;&|;&"
    ],
    [
      "compound.for",
      "(?<![\\p{L}\\p{N}_])for\\s+[\\p{L}\\p{N}_]+(\\s+in(?![\\p{L}\\p{N}_])|\\s*;|\\s*$)"
    ],
    [
      "compound.for-arith",
      "(?<![\\p{L}\\p{N}_])for\\s*\\(\\("
    ],
    [
      "compound.while",
      "(?<![\\p{L}\\p{N}_])while(?![\\p{L}\\p{N}_])"
    ],
    [
      "compound.until",
      "(?<![\\p{L}\\p{N}_])until(?![\\p{L}\\p{N}_])"
    ],
    [
      "compound.select",
      "(?<![\\p{L}\\p{N}_])select\\s+[\\p{L}\\p{N}_]+"
    ],
    [
      "compound.arith",
      "(^|[;&|]\\s*)\\(\\("
    ],
    [
      "compound.cond",
      "\\[\\["
    ],
    [
      "compound.cond.regex",
      "=~"
    ],
    [
      "compound.function",
      "[\\p{L}\\p{N}_]+\\s*\\(\\)\\s*\\{|(?<![\\p{L}\\p{N}_])function\\s+[\\p{L}\\p{N}_]+"
    ],
    [
      "compound.function.local",
      "(?<![\\p{L}\\p{N}_])local(?![\\p{L}\\p{N}_])"
    ],
    [
      "param.positional",
      "\\$[1-9#@*]|(?<![\\p{L}\\p{N}_])shift(?![\\p{L}\\p{N}_])|(?<![\\p{L}\\p{N}_])set\\s+--"
    ],
    [
      "param.special",
      "\\$[?$!0_-]"
    ],
    [
      "param.array.indexed",
      "[\\p{L}\\p{N}_]+=\\(|\\$\\{[\\p{L}\\p{N}_]+\\[[@*0-9]"
    ],
    [
      "param.array.assoc",
      "declare\\s+-[\\p{L}\\p{N}_]*A|local\\s+-[\\p{L}\\p{N}_]*A"
    ],
    [
      "param.nameref",
      "(declare|local)\\s+-[\\p{L}\\p{N}_]*n"
    ],
    [
      "param.indirect",
      "\\$\\{![\\p{L}\\p{N}_]+\\}"
    ],
    [
      "param.readonly",
      "(?<![\\p{L}\\p{N}_])readonly(?![\\p{L}\\p{N}_])|declare\\s+-[\\p{L}\\p{N}_]*r"
    ],
    [
      "param.export",
      "(?<![\\p{L}\\p{N}_])export(?![\\p{L}\\p{N}_])"
    ],
    [
      "param.attributes",
      "declare\\s+-[\\p{L}\\p{N}_]*[ilux]"
    ],
    [
      "param.callstack",
      "FUNCNAME|BASH_SOURCE|LINENO"
    ],
    [
      "param.random",
      "\\$\\{?(RANDOM|SECONDS|EPOCHSECONDS|EPOCHREALTIME|SRANDOM)"
    ],
    [
      "expansion.brace",
      "\\{[^{}\\s,]*,[^{}\\s]*\\}|\\{[^{}\\s]+\\.\\.[^{}\\s]+\\}"
    ],
    [
      "expansion.tilde",
      "(^|[\\s=:])~"
    ],
    [
      "expansion.parameter.default",
      "\\$\\{[^}]*:?[-=][^}]*\\}"
    ],
    [
      "expansion.parameter.alternative",
      "\\$\\{[^}]*:?\\+[^}]*\\}"
    ],
    [
      "expansion.parameter.error",
      "\\$\\{[\\p{L}\\p{N}_]+:?\\?"
    ],
    [
      "expansion.parameter.length",
      "\\$\\{#[\\p{L}\\p{N}_]"
    ],
    [
      "expansion.parameter.substring",
      "\\$\\{[\\p{L}\\p{N}_]+:[-0-9 ]"
    ],
    [
      "expansion.parameter.trim",
      "\\$\\{[\\p{L}\\p{N}_]+(\\[[^\\]]*\\])?(##?|%%?)"
    ],
    [
      "expansion.parameter.replace",
      "\\$\\{[\\p{L}\\p{N}_]+(\\[[^\\]]*\\])?//?"
    ],
    [
      "expansion.parameter.case",
      "\\$\\{[\\p{L}\\p{N}_]+(\\^\\^?|,,?)"
    ],
    [
      "expansion.parameter.transform",
      "\\$\\{[\\p{L}\\p{N}_]+@[QEPAaULuK]\\}"
    ],
    [
      "expansion.parameter.names",
      "\\$\\{![\\p{L}\\p{N}_]+(\\*|@|\\[)"
    ],
    [
      "expansion.command",
      "\\$\\((?!\\()|`"
    ],
    [
      "expansion.arithmetic",
      "\\$\\(\\("
    ],
    [
      "expansion.process",
      "[<>]\\("
    ],
    [
      "expansion.word-splitting",
      "(?<![\\p{L}\\p{N}_])IFS="
    ],
    [
      "redirection.input",
      "(^|[^<])<[^<&(]"
    ],
    [
      "redirection.output",
      "(^|[^>&])>[^>&(|]"
    ],
    [
      "redirection.append",
      ">>"
    ],
    [
      "redirection.noclobber",
      ">\\||(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*C|noclobber"
    ],
    [
      "redirection.both",
      "&>"
    ],
    [
      "redirection.duplicate",
      "\\d?[<>]&\\d"
    ],
    [
      "redirection.close",
      "[<>]&-"
    ],
    [
      "redirection.heredoc",
      "<<[^<-]"
    ],
    [
      "redirection.heredoc.strip",
      "<<-"
    ],
    [
      "redirection.heredoc.quoted",
      "<<-?\\s*['\"]"
    ],
    [
      "redirection.herestring",
      "<<<"
    ],
    [
      "redirection.fd-variable",
      "\\{[\\p{L}\\p{N}_]+\\}[<>]"
    ],
    [
      "redirection.dev-paths",
      "/dev/(null|stdin|stdout|stderr|fd/)"
    ],
    [
      "redirection.exec",
      "(?<![\\p{L}\\p{N}_])exec\\s+\\d*[<>]"
    ],
    [
      "option.errexit",
      "(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*e|(?<![\\p{L}\\p{N}_])bash\\s+-[\\p{L}\\p{N}_]*e"
    ],
    [
      "option.nounset",
      "(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*u|(?<![\\p{L}\\p{N}_])bash\\s+-[\\p{L}\\p{N}_]*u"
    ],
    [
      "option.xtrace",
      "(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*x"
    ],
    [
      "option.pipefail",
      "pipefail"
    ],
    [
      "option.noglob",
      "(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*f"
    ],
    [
      "option.allexport",
      "(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*a"
    ],
    [
      "option.noexec",
      "(?<![\\p{L}\\p{N}_])set\\s+-[\\p{L}\\p{N}_]*n"
    ],
    [
      "option.posix",
      "-o\\s+posix"
    ],
    [
      "option.lastpipe",
      "lastpipe"
    ],
    [
      "option.nocasematch",
      "nocasematch"
    ],
    [
      "expansion.glob.options",
      "extglob|globstar|nullglob|failglob|dotglob|nocaseglob"
    ],
    [
      "trap.exit",
      "(?<![\\p{L}\\p{N}_])trap(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])EXIT(?![\\p{L}\\p{N}_])"
    ],
    [
      "trap.err",
      "(?<![\\p{L}\\p{N}_])trap(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])ERR(?![\\p{L}\\p{N}_])"
    ],
    [
      "trap.pipe",
      "(?<![\\p{L}\\p{N}_])trap(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])(PIPE|SIGPIPE|13)(?![\\p{L}\\p{N}_])"
    ],
    [
      "trap.signal",
      "(?<![\\p{L}\\p{N}_])trap(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])(TERM|INT|HUP)(?![\\p{L}\\p{N}_])"
    ],
    [
      "trap.debug-return",
      "(?<![\\p{L}\\p{N}_])trap(?![\\p{L}\\p{N}_]).*(?<![\\p{L}\\p{N}_])(DEBUG|RETURN)(?![\\p{L}\\p{N}_])"
    ],
    [
      "jobs.background",
      "[^&]&(\\s|$)(?!&)"
    ],
    [
      "jobs.wait",
      "(?<![\\p{L}\\p{N}_])wait(?![\\p{L}\\p{N}_])"
    ],
    [
      "jobs.kill",
      "(?<![\\p{L}\\p{N}_])kill(?![\\p{L}\\p{N}_])"
    ],
    [
      "child.shell",
      "(?<![\\p{L}\\p{N}_])(sh|bash)\\s+-[\\p{L}\\p{N}_]*c(?![\\p{L}\\p{N}_])"
    ],
    [
      "child.exec",
      "-exec(?![\\p{L}\\p{N}_])|(?<![\\p{L}\\p{N}_])xargs(?![\\p{L}\\p{N}_])"
    ],
    [
      "tool.sibling",
      "(?<![\\p{L}\\p{N}_])probe-tool(?![\\p{L}\\p{N}_])"
    ]
  ],
  "commandStart": "(?:[;&|(){}`]|\\$\\(|(?<![\\p{L}\\p{N}_])(?:then|do|else|in|while|until|if|elif|time)(?![\\p{L}\\p{N}_])|!|^)\\s*(?=(?:[\\p{L}\\p{N}_]+=[^\\s]*\\s+)*([.:\\[]|[A-Za-z_][\\p{L}\\p{N}_-]*)(?=\\s|;|$|\\)|&|\\|))"
}
