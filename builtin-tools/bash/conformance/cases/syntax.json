{
  "tier": "pr",
  "description": "Syntax: comments, continuations, and how much of a script runs around a syntax error.\n\nThe tool checks the whole script before running it, so these cases show where that differs from\nbash, which parses and runs one command at a time.",
  "cases": [
    {
      "name": "syntax: comments",
      "script": "echo a # trailing\n# whole line\necho b#not-a-comment; echo \"#quoted\"",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: line continuation",
      "script": "echo a \\\nb; x=1\\\n2; echo $x",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: empty script",
      "script": "",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: only comments",
      "script": "# nothing\n  # here",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: error on a later line",
      "script": "echo first\nif then\necho after",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 2: syntax error near unexpected token `then'\nbash: -c: line 2: `if then'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: error on the same line",
      "script": "echo first; if then; echo after",
      "tags": [
        "syntax.error"
      ],
      "options": {}
    },
    {
      "name": "syntax: unterminated quote",
      "script": "echo first\necho \"open",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 2: unexpected EOF while looking for matching `\"'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: unterminated substitution",
      "script": "echo first\necho $(echo x",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 3: unexpected EOF while looking for matching `)'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: unexpected token",
      "script": "echo first\n) oops\necho after",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 2: syntax error near unexpected token `)'\nbash: -c: line 2: `) oops'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: missing done",
      "script": "for i in 1; do echo $i",
      "tags": [
        "syntax.error"
      ],
      "options": {}
    },
    {
      "name": "syntax: stray fi",
      "script": "echo a\nfi\necho b",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 2: syntax error near unexpected token `fi'\nbash: -c: line 2: `fi'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: error inside a function body",
      "script": "f() { echo in; }\nf\ng() { if; }\necho after",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 3: syntax error near unexpected token `;'\nbash: -c: line 3: `g() { if; }'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: error inside eval",
      "script": "eval \"echo ok; if\"; echo status=$?; echo after",
      "tags": [
        "syntax.error"
      ],
      "options": {}
    },
    {
      "name": "syntax: error in a trap body runs later",
      "script": "trap \"if\" EXIT; echo body",
      "tags": [
        "syntax.error",
        "trap.exit"
      ],
      "options": {}
    },
    {
      "name": "syntax: deep nesting",
      "script": "echo $(echo $(echo $(echo $(echo $(echo $(echo deep))))))",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: keywords as arguments",
      "script": "echo if then fi do done case esac in { }",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: semicolons and newlines",
      "script": "echo a;echo b\n\n\necho c ;; echo d",
      "tags": [
        "syntax.error"
      ],
      "options": {},
      "expected": {
        "status": 2,
        "stdout": {
          "text": ""
        },
        "stderr": {
          "text": "bash: -c: line 4: syntax error near unexpected token `;;'\nbash: -c: line 4: `echo c ;; echo d'\n"
        },
        "reason": "the tool checks the whole script before running any of it, so nothing runs; bash runs the commands before the error"
      }
    },
    {
      "name": "syntax: reserved words need separators",
      "script": "if true; then echo t; fi; if true;then echo t2;fi",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: function name validity",
      "script": "my-func() { echo dash; }; my-func; my.func() { echo dot; }; my.func",
      "tags": [],
      "options": {}
    },
    {
      "name": "syntax: long lines",
      "script": "; echo ${#x}",
      "tags": [],
      "options": {}
    }
  ]
}
