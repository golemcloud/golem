{
  "tier": "pr",
  "description": "jq conformance: jq 1.8.2 in the oracle is the reference for status, stdout and stderr.",
  "cases": [
    {
      "name": "jq: pretty print",
      "script": "echo '{\"name\":\"ada\",\"age\":36,\"tags\":[\"x\",\"y\"],\"nested\":{\"k\":[1,2,{\"z\":null}]}}' | jq .",
      "tags": [],
      "options": {}
    },
    {
      "name": "jq: default filter",
      "script": "echo '{\"name\":\"ada\",\"age\":36,\"tags\":[\"x\",\"y\"],\"nested\":{\"k\":[1,2,{\"z\":null}]}}' | jq",
      "tags": [],
      "options": {}
    },
    {
      "name": "jq: raw field",
      "script": "echo '{\"name\":\"ada\",\"age\":36,\"tags\":[\"x\",\"y\"],\"nested\":{\"k\":[1,2,{\"z\":null}]}}' | jq -r .name",
      "tags": [],
      "options": {}
    },
    {
      "name": "jq: nested path",
