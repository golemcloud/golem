{
  "name": "@golem/bash-conformance",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "bun test",
    "conformance": "bun run conformance.ts",
    "baseline": "bun run compat/baseline.ts"
  },
  "dependencies": {
    "@effect/platform": "0.96.2",
    "@effect/platform-node": "0.107.0",
    "effect": "3.22.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "dprint": "0.65.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
