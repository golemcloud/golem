package golem:agent@2.0.0;

interface common {
  use golem:core/types@2.0.0.{schema-graph, type-node-index, typed-schema-value,
    metadata-envelope, agent-id, account-id, component-id, environment-id, uuid, datetime};
  use golem:core/http@2.0.0.{http-route-mode, durable-stream-route-options};
  use wasi:clocks/types@0.3.0.{duration};

  enum agent-mode {
    durable,
    ephemeral
  }

  /// Full agent type declaration.
  ///
  /// `schema` is the per-agent type-node pool. Constructor / method / config
  /// schema roots below are `type-node-index` values into `schema`. The
  /// `schema.root` field is a structurally-required placeholder and is not the
  /// semantic root of the agent type.
  record agent-type {
    type-name:       string,
    kind:            agent-type-kind,
    description:     string,
    source-language: string,
    schema:          schema-graph,
    %constructor:    agent-constructor,
    methods:         list<agent-method>,
    dependencies:    list<agent-dependency>,
    mode:            agent-mode,
    http-mount:      option<http-mount-details>,
    snapshotting:    snapshotting,
    config:       list<agent-config-declaration>,
  }

  enum agent-type-kind {
    regular,
    http-router,
  }

  /// Associates an agent type with a component that implements it
  record registered-agent-type {
    agent-type: agent-type,
    implemented-by: component-id
  }

  /// Dependent agent type. All schema roots inside it resolve against its own
  /// `schema`, not against the parent agent-type's graph.
  record agent-dependency {
    type-name:    string,
    description:  option<string>,
    schema:       schema-graph,
    %constructor: agent-constructor,
    methods:      list<agent-method>,
  }

  /// Ordered, named input parameters with per-field source annotation.
  variant input-schema {
    parameters(list<named-field>),
  }

  record named-field {
    name:     string,
    source:   field-source,
    /// Index into the owning agent-type / dependency `schema` graph.
    schema:   type-node-index,
    metadata: metadata-envelope,
  }

  variant field-source {
    user-supplied,
  }

  /// Output is either unit (no value) or a single value of the given type.
  variant output-schema {
    unit,
    /// Index into the owning agent-type / dependency `schema` graph.
    single(type-node-index),
  }

  record agent-method {
    name:          string,
    description:   string,
    http-endpoint: list<http-endpoint-details>,
    prompt-hint:   option<string>,
    input-schema:  input-schema,
    output-schema: output-schema,
    read-only:     option<read-only-config>,
  }

  record read-only-config {
    cache-policy:    cache-policy,
  }

  variant cache-policy {
    no-cache,
    until-write,
    ttl(duration),
  }

  record http-mount-details {
    path-prefix:    list<path-segment>,
    auth-details:   option<auth-details>,
    phantom-agent:  bool,
    phantom-id-binding: option<phantom-id-binding>,
    cors-options:   cors-options,
    webhook-suffix: list<path-segment>,
    static-bindings: list<file-mapping>,
    filesystem-bindings: list<file-mapping>,
    /// Additional response headers for files served by static-bindings or filesystem-bindings.
    file-response-headers: list<file-response-header>,
    /// The name of a parameterless router method that returns the OpenAPI document as a string.
    openapi-provider-method: option<string>,
  }

  variant phantom-id-binding {
    path(phantom-id-binding-details),
    query(phantom-id-binding-details),
  }

  record phantom-id-binding-details {
    name: string,
    optional: bool,
  }

  record file-response-header {
    name: string,
    value: string,
  }

  variant file-mapping {
    exact(exact-file-mapping),
    subtree(subtree-file-mapping),
  }

  record exact-file-mapping {
    public-path: list<string>,
    file-path: string,
  }

  record subtree-file-mapping {
    public-prefix: list<string>,
    filesystem-root: string,
  }

  record cors-options {
    allowed-patterns: list<string>,
  }

  record http-endpoint-details {
    http-method: http-method,
    path-suffix:  list<path-segment>,
    header-vars:  list<header-variable>,
    query-vars:   list<query-variable>,
    auth-details: option<auth-details>,
    cors-options: cors-options,
    mode: option<http-route-mode>,
    durable-streams: option<durable-stream-route-options>,
  }

  variant http-method {
    get,
    head,
    post,
    put,
    delete,
    connect,
    options,
    trace,
    patch,
    custom(string),
    any,
  }

  variant path-segment {
    literal(string),
    system-variable(system-variable),
    path-variable(path-variable),
    // only allowed as the last segment
    remaining-path-variable(path-variable)
  }

  enum system-variable {
    agent-type,
    agent-version
  }

  record path-variable {
    variable-name: string,
  }

  record header-variable {
    header-name: string,
    variable-name: string,
  }

  record query-variable {
    query-param-name: string,
    variable-name: string,
  }

  record auth-details {
    required: bool,
  }

  /// The (issuer, subject) pair of one principal. A reference is data: holding one grants
  /// nothing. Two references name the same principal exactly when both strings are equal,
  /// byte for byte.
  record principal-ref {
    issuer:  string,
    subject: string,
  }

  /// One identity, as Golem verified it. Every kind except anonymous has a pair.
  variant principal {
    user(user-principal),
    account(account-principal),
    agent(agent-principal),
    tool(tool-principal),
    anonymous,
  }

  /// A user, authenticated by a sign-in provider: the provider's pair.
  record user-principal {
    pair:             principal-ref,
    /// The verified claims, as the JSON object that Golem received.
    claims:           string,
    authenticated-at: datetime,
  }

  enum account-authentication {
    api-token,
    bootstrap-token,
    sign-in,
  }

  /// An account: (Golem issuer, "account:<account-id>").
  record account-principal {
    pair:           principal-ref,
    account-id:     account-id,
    authentication: account-authentication,
  }

  /// An agent: (Golem issuer, "agent:<agent-id>/<fingerprint>").
  record agent-principal {
    pair:           principal-ref,
    agent-id:       agent-id,
    agent-type:     string,
    environment-id: environment-id,
  }

  /// A tool: (Golem issuer, "tool:<environment-id>/<tool-name>").
  record tool-principal {
    pair:           principal-ref,
    environment-id: environment-id,
    tool-name:      string,
  }

  /// A token that the request presented, and the reference of its maker. It never holds the
  /// token's value.
  record token-provenance {
    id:    uuid,
    maker: option<principal-ref>,
  }

  /// The principals that caused an invocation, and the tokens presented at the entry point.
  record caller {
    /// The principal at the root of the call tree.
    original:  principal,
    /// The principal that made this call.
    immediate: principal,
    tokens:    list<token-provenance>,
  }

  record agent-constructor {
    name:          option<string>,
    description:   string,
    prompt-hint:   option<string>,
    input-schema:  input-schema,
  }

  variant snapshotting {
    disabled,
    enabled(snapshotting-config)
  }

  variant snapshotting-config {
    default, // current default in the server
    periodic(duration),
    every-n-invocation(u16)
  }

  enum agent-config-source {
    local,
    secret
  }

  record agent-config-declaration {
    source: agent-config-source,
    path: list<string>,
    /// Index into the owning agent-type `schema` graph.
    value-type: type-node-index,
  }

  record typed-agent-config-value {
    path: list<string>,
    value: typed-schema-value,
  }

  /// Agent-level failures
  variant agent-error {
    invalid-input(string),
    invalid-method(string),
    invalid-type(string),
    invalid-agent-id(string),
    custom-error(typed-schema-value),
  }
}
