package golem:websocket@1.5.0;

interface client {
  enum reconstruction-policy {
    reconnect-automatically,
    report-connection-loss,
  }

  variant error {
    connection-failure(string),
    send-failure(string),
    receive-failure(string),
    protocol-error(string),
    closed(option<close-info>),
    other(string),
    /// The physical session did not survive runtime reconstruction.
    /// An earlier send may still have reached the remote server.
    session-lost,
  }

  record close-info {
    code: u16,
    reason: string,
  }

  /// A WebSocket message — text or binary
  variant message {
    text(string),
    binary(list<u8>),
  }

  /// A WebSocket connection resource
  resource websocket-connection {
    /// Connect to a WebSocket server at the given URL (ws:// or wss://)
    /// Optional headers for auth, subprotocols, etc.
    connect: static func(
      url: string,
      headers: option<list<tuple<string, string>>>,
      /// Defaults to reconnect-automatically. Completed durable operations
      /// replay unchanged under either policy. report-connection-loss prevents
      /// replacement I/O on reconstructed handles; it does not retry ordinary
      /// network disconnects or bypass non-idempotent recovery guards.
      reconstruction-policy: option<reconstruction-policy>
    ) -> result<websocket-connection, error>;

    /// Send a message (text or binary)
    send: func(message: message) -> result<_, error>;

    /// Receive the next message (blocks until available)
    receive: async func() -> result<message, error>;

    /// Receive the next message with a timeout in milliseconds.
    /// Returns none if the timeout expires before a message arrives.
    receive-with-timeout: async func(timeout-ms: u64) -> result<option<message>, error>;

    /// Send a close frame with optional code and reason. A reconstructed handle
    /// using report-connection-loss returns session-lost without reconnecting.
    /// Dropping the resource releases it locally without opening a connection.
    close: func(code: option<u16>, reason: option<string>) -> result<_, error>;
  }
}
