name = "golemcloud/golem_sdk_tools"

version = "0.5.1"

import {
  "moonbitlang/x@0.5.1",
  "moonbitlang/parser@0.3.18",
  "moonbitlang/lexer@0.3.15",
}

readme = "README.mbt.md"

repository = "https://github.com/golemcloud/moonbit-sdk"

license = "Apache-2.0"

keywords = [
  "golem",
  "wasm",
  "agent",
  "codegen",
  "webassembly",
  "component-model",
]

description = "Code generation tools for the Golem SDK for MoonBit"
