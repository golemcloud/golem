///|
/// Rejoins string literals that the MoonBit formatter broke across lines.
/// Detects lines with an odd number of quotes (indicating an unterminated
/// string) and merges subsequent lines until the string is closed.
fn fix_broken_strings(input : String) -> String {
  let lines = input.split("\n")
  let result : Array[String] = []
  let mut in_broken = false
  let mut acc = ""
  for line in lines {
    let s = line.trim_end(chars=" ").to_string()
    if in_broken {
      acc = acc + " " + s.trim_start(chars=" ").to_string()
      let trimmed = s.trim_end(chars=" ").to_string()
      if trimmed.has_suffix("\"") || trimmed.has_suffix("\",") {
        result.push(acc)
        in_broken = false
        acc = ""
      }
    } else {
      let mut quotes = 0
      for ch in s {
        if ch == '"' {
          quotes += 1
        }
      }
      if quotes % 2 != 0 {
        in_broken = true
        acc = s
      } else {
        result.push(s)
      }
    }
  }
  if in_broken {
    result.push(acc)
  }
  result.join("\n").trim_end(chars="\n").to_string() + "\n"
}

///|
let generated_file_banner = "// Generated by golem_sdk_tools — DO NOT EDIT!"

///|
priv struct GeneratedFileWrite {
  path : String
  content : String
  message : String
}

///|
priv struct GeneratedFilePlan {
  writes : Array[GeneratedFileWrite]
  removals : Array[String]
}

///|
fn GeneratedFilePlan::new() -> GeneratedFilePlan {
  { writes: [], removals: [] }
}

///|
fn GeneratedFilePlan::stage_write(
  self : GeneratedFilePlan,
  path : String,
  content : String,
  message : String,
) -> Unit {
  self.writes.push({ path, content, message })
}

///|
fn GeneratedFilePlan::stage_removal(
  self : GeneratedFilePlan,
  path : String,
) -> Unit {
  self.removals.push(path)
}

///|
fn GeneratedFilePlan::preflight(self : GeneratedFilePlan) -> Unit raise {
  for write in self.writes {
    validate_generated_write_path(write.path)
  }
  for path in self.removals {
    validate_generated_removal_path(path)
  }
}

///|
fn GeneratedFilePlan::apply(self : GeneratedFilePlan) -> Unit raise {
  for write in self.writes {
    @fs.write_string_to_file(write.path, write.content)
    println(write.message)
  }
  for path in self.removals {
    if @fs.path_exists(path) {
      @fs.remove_file(path)
      println("Removed stale \{path}")
    }
  }
}

///|
fn main {
  let args = @env.args()
  if args.length() < 2 {
    println(
      "Usage: golem_sdk_tools <command> <args>\nCommands:\n  reexports <sdk-path> <target-dir> --role <role>\n  agents <project-root> --component-dir <component-dir> --role <role>",
    )
    @sys.exit(1)
    return
  }
  let command_args : Array[String] = []
  for i = 2; i < args.length(); i = i + 1 {
    command_args.push(args[i])
  }
  if args[1] == "reexports" {
    let options = @lib.parse_reexports_command_args(command_args) catch {
      @lib.ComponentRoleError(message) => {
        println("Error: \{message}")
        @sys.exit(1)
        return
      }
    }
    run_reexports(options.sdk_path, options.target_dir, options.role) catch {
      @lib.ComponentRoleError(message) => {
        println("Error: \{message}")
        @sys.exit(1)
      }
      e => {
        println("Error: \{e}")
        @sys.exit(1)
      }
    }
  } else if args[1] == "agents" {
    let options = @lib.parse_agents_command_args(command_args) catch {
      @lib.ComponentRoleError(message) => {
        println("Error: \{message}")
        @sys.exit(1)
        return
      }
    }
    run_agents(options.project_root, options.component_dir, options.role) catch {
      @lib.ComponentRoleError(message) => {
        println("Error: \{message}")
        @sys.exit(1)
      }
      e => {
        println("Error: \{e}")
        @sys.exit(1)
      }
    }
  } else {
    println("Unknown command: \{args[1]}")
    @sys.exit(1)
  }
}

///|
/// Runs the `agents` subcommand: scans a project for shared schema context and
/// writes generated code only to the selected component package.
fn run_agents(
  project_root : String,
  component_dir : String,
  role : @lib.ComponentRole,
) -> Unit raise {
  let scans = @lib.discover_and_scan(project_root)
  let target_dir = @lib.component_target_dir(project_root, component_dir)
  if !scans.iter().any(fn(scan) { scan.pkg.dir == target_dir }) {
    @lib.raise_component_role_error(
      "Component directory '" + target_dir + "' is not a package in the project",
    )
  }
  // Collect all config types across all packages for cross-package validation
  let all_config_types : Array[@lib.ConfigTypeInfo] = []
  for scan in scans {
    let config_types = @lib.parse_config_types(
      scan.files,
      package=scan.pkg.rel_path,
    )
    for ct in config_types {
      all_config_types.push(ct)
    }
  }
  for scan in scans {
    if scan.pkg.dir != target_dir {
      continue
    }
    let pkg_dir = scan.pkg.dir
    let files = scan.files
    // Parse annotations from this package
    let value_types = @lib.parse_value_types(files)
    let multimodal_enums = @lib.parse_multimodal_enums(files)
    let config_types = @lib.parse_config_types(files, package=scan.pkg.rel_path)
    let agents = @lib.parse_agents(files)
    let tools = @lib.parse_tools(files)
    let has_middleware_annotations = @lib.has_middleware_annotations(files)
    @lib.validate_component_role(
      role,
      agents.length(),
      has_middleware_annotations,
    )
    let middlewares = if has_middleware_annotations {
      @lib.parse_tool_middlewares(files)
    } else {
      []
    }
    validate_component_role_marker(pkg_dir, role)
    let has_derive = value_types.length() > 0 ||
      multimodal_enums.length() > 0 ||
      config_types.length() > 0
    let has_agents = agents.length() > 0
    let has_tools = tools.length() > 0
    let has_middlewares = middlewares.length() > 0
    let required_pkg_imports : Array[(String, String)] = []
    let file_plan = GeneratedFilePlan::new()
    if has_middlewares && role.allows_tool_middleware_registration() {
      let middleware_impls = @lib.generate_tool_middleware_registration(
        middlewares, tools, role,
      )
      let middleware_formatted = fix_broken_strings(
        @formatter.impls_to_string(middleware_impls),
      )
      let middleware_output = generated_file_banner +
        "\n\n" +
        middleware_formatted
      let middleware_path = "\{pkg_dir}/golem_tool_middlewares.mbt"
      file_plan.stage_write(
        middleware_path,
        middleware_output,
        "Generated \{middleware_path} with \{middlewares.length()} tool middleware(s)",
      )
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/tool-middleware", "@toolMiddleware"),
      )
      if middlewares.any(middleware => {
          middleware.scope is @lib.ToolMiddlewareScopeInfo::Monomorphic(_)
        }) {
        required_pkg_imports.push(
          (
            if role is @lib.ComponentRole::ToolMiddleware {
              "golemcloud/golem_sdk/tool-core"
            } else {
              "golemcloud/golem_sdk/tool"
            },
            "@tool",
          ),
        )
        required_pkg_imports.push(("golemcloud/golem_sdk/schema", "@schema"))
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/schema_model", "@model"),
        )
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/interface/golem/core/types", "@types"),
        )
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/interface/golem/tool/common", "@toolCommon"),
        )
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/async-core", "@asyncCore"),
        )
      }
    } else {
      file_plan.stage_removal("\{pkg_dir}/golem_tool_middlewares.mbt")
    }
    if has_tools && role.allows_tool_registration() {
      let tool_impls = @lib.generate_tool_registration(tools)
      let tool_formatted = fix_broken_strings(
        @formatter.impls_to_string(tool_impls),
      )
      let tool_output = generated_file_banner + "\n\n" + tool_formatted
      let tool_path = "\{pkg_dir}/golem_tools.mbt"
      file_plan.stage_write(
        tool_path,
        tool_output,
        "Generated \{tool_path} with \{tools.length()} tool(s)",
      )
      let tool_client_impls = @lib.generate_tool_client_code(tools)
      let tool_client_formatted = fix_broken_strings(
        @formatter.impls_to_string(tool_client_impls),
      )
      let tool_client_output = generated_file_banner +
        "\n\n" +
        tool_client_formatted
      let tool_client_path = "\{pkg_dir}/golem_tool_clients.mbt"
      file_plan.stage_write(
        tool_client_path,
        tool_client_output,
        "Generated \{tool_client_path} with \{tools.length()} tool client(s)",
      )
      required_pkg_imports.push(("golemcloud/golem_sdk/tool", "@tool"))
      required_pkg_imports.push(("golemcloud/golem_sdk/schema", "@schema"))
      required_pkg_imports.push(("golemcloud/golem_sdk/schema_model", "@model"))
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/interface/golem/core/types", "@types"),
      )
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/interface/golem/tool/common", "@toolCommon"),
      )
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/async-core", "@asyncCore"),
      )
    } else {
      file_plan.stage_removal("\{pkg_dir}/golem_tools.mbt")
      file_plan.stage_removal("\{pkg_dir}/golem_tool_clients.mbt")
    }
    if has_agents && role.allows_agent_registration() {
      // --- Agent package: generate golem_agents.mbt, golem_derive.mbt, golem_clients.mbt ---
      if agents[0].has_init {
        println(
          "Warning: existing fn init found in \{pkg_dir}. Remove it to avoid conflicts with generated code.",
        )
      }
      // Cross-package config validation
      @lib.validate_config_types(
        agents,
        all_config_types,
        agent_package=scan.pkg.rel_path,
      )
      // golem_agents.mbt
      let impls = @lib.generate_agent_registration(agents)
      let formatted = fix_broken_strings(@formatter.impls_to_string(impls))
      let output = generated_file_banner + "\n\n" + formatted
      let output_path = "\{pkg_dir}/golem_agents.mbt"
      file_plan.stage_write(
        output_path,
        output,
        "Generated \{output_path} with \{agents.length()} agent(s)",
      )
      // golem_derive.mbt
      if has_derive || all_config_types.length() > 0 {
        let derive_output = generate_derive_file(
          value_types,
          multimodal_enums,
          config_types,
          all_config_types~,
          type_id_prefix=dotted_pkg(scan.pkg.rel_path),
        )
        let derive_path = "\{pkg_dir}/golem_derive.mbt"
        file_plan.stage_write(
          derive_path,
          derive_output,
          "Generated \{derive_path} with \{value_types.length()} type(s), \{multimodal_enums.length()} multimodal enum(s), and \{config_types.length()} config type(s)",
        )
      } else {
        file_plan.stage_removal("\{pkg_dir}/golem_derive.mbt")
      }
      // golem_clients.mbt
      let client_impls = @lib.generate_client_code(
        agents,
        config_types=all_config_types,
        agent_package=scan.pkg.rel_path,
      )
      let client_formatted = fix_broken_strings(
        @formatter.impls_to_string(client_impls),
      )
      let client_output = generated_file_banner + "\n\n" + client_formatted
      let client_path = "\{pkg_dir}/golem_clients.mbt"
      file_plan.stage_write(
        client_path,
        client_output,
        "Generated golem_clients.mbt with \{agents.length()} client(s)",
      )
      required_pkg_imports.push(("golemcloud/golem_sdk/agents", "@agents"))
      required_pkg_imports.push(("golemcloud/golem_sdk/schema", "@schema"))
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/interface/golem/agent/common", "@common"),
      )
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/interface/golem/core/types", "@types"),
      )
      required_pkg_imports.push(("golemcloud/golem_sdk/rpc", "@rpc"))
      required_pkg_imports.push(
        ("golemcloud/golem_sdk/interface/golem/agent/host", "@agentHost"),
      )
      required_pkg_imports.push(
        (
          "golemcloud/golem_sdk/interface/wasi/clocks/system-clock", "@systemClock",
        ),
      )
      // JSON snapshot helpers are emitted for agents deriving ToJson/FromJson.
      let needs_json = agents
        .iter()
        .any(fn(a) { a.has_json_derives && not(a.has_snapshottable) })
      if needs_json {
        required_pkg_imports.push(("moonbitlang/core/json", "@json"))
        required_pkg_imports.push(("moonbitlang/core/encoding/utf8", "@utf8"))
      }
      // Custom #derive.golem_schema types emit a golem_derive.mbt in this same
      // package that references @model (schema_model).
      if has_derive {
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/schema_model", "@model"),
        )
      }
      // Multimodal agents reference @multimodal.Multimodal[...] in the agent
      // type/dispatch, and #derive.multimodal enums emit MultimodalModality
      // impls into golem_derive.mbt.
      if has_multimodal_agent(agents) || multimodal_enums.length() > 0 {
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/multimodal", "@multimodal"),
        )
      }
      let uses_config = agents.iter().any(fn(a) { a.config_type is Some(_) })
      if uses_config || config_types.length() > 0 {
        required_pkg_imports.push(("golemcloud/golem_sdk/config", "@config"))
      }
    } else if has_derive {
      // --- Non-agent package with derive types: generate golem_derive.mbt only ---
      let derive_output = generate_derive_file(
        value_types,
        multimodal_enums,
        config_types,
        type_id_prefix=dotted_pkg(scan.pkg.rel_path),
      )
      let derive_path = "\{pkg_dir}/golem_derive.mbt"
      file_plan.stage_write(
        derive_path,
        derive_output,
        "Generated \{derive_path} with \{value_types.length()} type(s), \{multimodal_enums.length()} multimodal enum(s), and \{config_types.length()} config type(s)",
      )
      required_pkg_imports.push(("golemcloud/golem_sdk/schema", "@schema"))
      required_pkg_imports.push(("golemcloud/golem_sdk/schema_model", "@model"))
      if multimodal_enums.length() > 0 {
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/multimodal", "@multimodal"),
        )
      }
      if config_types.length() > 0 {
        required_pkg_imports.push(("golemcloud/golem_sdk/config", "@config"))
        required_pkg_imports.push(("golemcloud/golem_sdk/agents", "@agents"))
        required_pkg_imports.push(
          ("golemcloud/golem_sdk/interface/golem/agent/common", "@common"),
        )
      }
    }
    // Clean up stale files for categories not present in this package
    if not(has_agents) {
      file_plan.stage_removal("\{pkg_dir}/golem_agents.mbt")
      file_plan.stage_removal("\{pkg_dir}/golem_clients.mbt")
    }
    if not(has_derive) && not(has_agents) {
      file_plan.stage_removal("\{pkg_dir}/golem_derive.mbt")
    }
    let pkg_path = "\{pkg_dir}/moon.pkg"
    let pkg_content = @fs.read_file_to_string(pkg_path)
    let reconciled_pkg = @lib.reconcile_generated_pkg_imports(
      pkg_content,
      required_pkg_imports,
      forbid_ambient_tool=role is @lib.ComponentRole::ToolMiddleware,
    )
    file_plan.preflight()
    file_plan.apply()
    if reconciled_pkg != pkg_content {
      @fs.write_string_to_file(pkg_path, reconciled_pkg)
    }
    commit_component_role_marker(pkg_dir, role)
  }
}

///|
/// Converts a package's project-relative path (slash-separated) into the dotted
/// prefix used for default `type_id()`s (e.g. `src/foo` -> `src.foo`).
fn dotted_pkg(rel_path : String) -> String {
  let parts : Array[String] = []
  for p in rel_path.split("/") {
    parts.push(p.to_string())
  }
  parts.join(".")
}

///|
/// Generates `golem_derive.mbt` from value types, multimodal enums, and config types.
/// When `all_config_types` is provided, also generates override types and walker
/// functions for config types reachable from agents in this package.
fn generate_derive_file(
  value_types : Array[@lib.ValueTypeInfo],
  multimodal_enums : Array[@lib.MultimodalEnumInfo],
  config_types : Array[@lib.ConfigTypeInfo],
  all_config_types? : Array[@lib.ConfigTypeInfo] = [],
  type_id_prefix? : String = "",
) -> String raise {
  let all_impls : Array[@syntax.Impl] = []
  if value_types.length() > 0 {
    @lib.generate_value_type_impls(value_types, type_id_prefix~).each(fn(i) {
      all_impls.push(i)
    })
  }
  if multimodal_enums.length() > 0 {
    @lib.generate_multimodal_impls(multimodal_enums, type_id_prefix~).each(fn(
      i,
    ) {
      all_impls.push(i)
    })
  }
  if config_types.length() > 0 {
    @lib.generate_config_field_impls(config_types).each(fn(i) {
      all_impls.push(i)
    })
  }
  if all_config_types.length() > 0 {
    @lib.generate_config_override_types(all_config_types).each(fn(i) {
      all_impls.push(i)
    })
    @lib.generate_config_override_walkers(all_config_types).each(fn(i) {
      all_impls.push(i)
    })
  }
  let derive_formatted = @formatter.impls_to_string(
    @list.List::from_array(all_impls),
  )
  generated_file_banner + "\n\n" + derive_formatted
}

///|
/// Writes a generated file without replacing a user-owned file at the managed path.
fn write_generated_file(path : String, content : String) -> Unit raise {
  validate_generated_write_path(path)
  @fs.write_string_to_file(path, content)
}

///|
fn validate_generated_write_path(path : String) -> Unit raise {
  if @fs.path_exists(path) {
    let existing = @fs.read_file_to_string(path)
    if !existing.has_prefix(generated_file_banner + "\n") {
      @lib.raise_component_role_error(
        "Refusing to overwrite non-generated file '" + path + "'",
      )
    }
  }
}

///|
fn validate_generated_removal_path(path : String) -> Unit raise {
  if @fs.path_exists(path) {
    let existing = @fs.read_file_to_string(path)
    if !existing.has_prefix(generated_file_banner + "\n") {
      @lib.raise_component_role_error(
        "Refusing to remove non-generated file '" + path + "'",
      )
    }
  }
}

///|
/// Validates that existing generated role state agrees with the selected role.
fn validate_component_role_marker(
  component_dir : String,
  role : @lib.ComponentRole,
) -> Unit raise {
  let marker_path = "\{component_dir}/.golem-sdk-role"
  if @fs.path_exists(marker_path) {
    let selected = @lib.parse_component_role_marker(
      @fs.read_file_to_string(marker_path),
    )
    if selected != role {
      @lib.raise_component_role_error(
        "Component role mismatch: '" +
        component_dir +
        "' was already generated as '" +
        selected.name() +
        "' but this command selected '" +
        role.name() +
        "'",
      )
    }
  }
}

///|
/// Commits role state after every other command operation has succeeded.
fn commit_component_role_marker(
  component_dir : String,
  role : @lib.ComponentRole,
) -> Unit raise {
  validate_component_role_marker(component_dir, role)
  let marker_path = "\{component_dir}/.golem-sdk-role"
  if not(@fs.path_exists(marker_path)) {
    @fs.write_string_to_file(marker_path, @lib.component_role_marker(role))
    println("Generated \{marker_path} for role \{role.name()}")
  }
}

///|
/// Checks if any agent uses multimodal types in its constructor or methods.
fn has_multimodal_agent(agents : Array[@lib.AgentInfo]) -> Bool {
  for a in agents {
    for p in a.constructor_params {
      if @lib.is_multimodal_type(p.1) {
        return true
      }
    }
    for m in a.methods {
      for p in m.params {
        if @lib.is_multimodal_type(p.1) {
          return true
        }
      }
      match m.return_type {
        Some(pt) => if @lib.is_multimodal_type(pt) { return true }
        None => ()
      }
    }
  }
  false
}

///|
/// Runs the `reexports` subcommand from the exact generated package selected by
/// the component role, then updates `golem_reexports.mbt` and `moon.pkg`.
fn run_reexports(
  sdk_path : String,
  target_dir : String,
  role : @lib.ComponentRole,
) -> Unit raise {
  validate_component_role_marker(target_dir, role)
  let target_pkg_path = "\{target_dir}/moon.pkg"
  let target_pkg_content = @fs.read_file_to_string(target_pkg_path)
  let role_safe_pkg_content = if role is @lib.ComponentRole::ToolMiddleware {
    @lib.reconcile_pure_role_pkg_imports(target_pkg_content)
  } else {
    target_pkg_content
  }
  let gen_package = role.gen_package()
  let gen_dir = "\{sdk_path}/\{gen_package}"
  let entries = @fs.read_dir(gen_dir)
  entries.sort_by((left, right) => left.compare(right))
  let fns : Array[@lib.FnSignature] = []
  for entry in entries {
    if entry.has_suffix(".mbt") {
      let content = @fs.read_file_to_string("\{gen_dir}/\{entry}")
      let file_fns = @lib.parse_mbt_source(content)
      for fn_ in file_fns {
        fns.push(fn_)
      }
    }
  }
  let impls = @lib.generate_reexports(fns, "gen")
  let formatted = @formatter.impls_to_string(impls)
  let output = generated_file_banner + "\n\n" + formatted
  let output_path = "\{target_dir}/golem_reexports.mbt"
  write_generated_file(output_path, output)
  println("Generated \{output_path} with \{fns.length()} functions")
  // Update target moon.pkg with the selected generated package's link section.
  let gen_pkg_path = if @fs.path_exists("\{gen_dir}/moon.pkg") {
    "\{gen_dir}/moon.pkg"
  } else {
    "\{gen_dir}/moon.pkg.json"
  }
  let gen_pkg_content = @fs.read_file_to_string(gen_pkg_path)
  let exports = @lib.transform_exports(@lib.parse_pkg_exports(gen_pkg_content))
  // Generated wrappers consistently use @gen while the imported package is
  // selected exactly from the component role.
  let with_gen_import = @lib.ensure_role_gen_import(
    role_safe_pkg_content,
    "golemcloud/golem_sdk/\{gen_package}",
  )
  let updated = @lib.update_pkg_link(with_gen_import, exports)
  @fs.write_string_to_file(target_pkg_path, updated)
  println("Updated \{target_pkg_path} with \{exports.length()} exports")
  commit_component_role_marker(target_dir, role)
}
