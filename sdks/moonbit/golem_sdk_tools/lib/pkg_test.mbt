///|
test "ensure_pkg_import adds one stable default generated import" {
  let content = "options(\n  \"is-main\": true,\n)"
  let once = @lib.ensure_pkg_import(content, "golemcloud/golem_sdk/gen", "@gen")
  let twice = @lib.ensure_pkg_import(once, "golemcloud/golem_sdk/gen", "@gen")
  assert_eq(once, twice)
  assert_eq(once.split("golemcloud/golem_sdk/gen").count() - 1, 1)
}

///|
test "ensure_pkg_import rejects unrelated ownership of the generated alias" {
  let error = try
    @lib.ensure_pkg_import(
      "import {\n  \"another/generator\" @gen,\n}", "golemcloud/golem_sdk/gen", "@gen",
    )
  catch {
    @lib.ComponentRoleError(message) => message
  } noraise {
    _ => "NO ERROR"
  }
  assert_true(error.contains("alias @gen is already used"))
}

///|
test "generated import reconciliation removes stale owned imports" {
  let with_tool = @lib.reconcile_generated_pkg_imports(
    "options(\n  \"is-main\": true,\n)",
    [("golemcloud/golem_sdk/tool", "@tool")],
  )
  assert_true(with_tool.contains("Generated by golem_sdk_tools"))
  let cleaned = @lib.reconcile_generated_pkg_imports(with_tool, [])
  assert_false(cleaned.contains("golemcloud/golem_sdk/tool"))
}

///|
test "update_pkg_link installs the default world's exports" {
  let updated = @lib.update_pkg_link("options(\n  \"is-main\": true,\n)", [
    "wasmExportDiscoverAgentTypes:golem:agent/guest@2.0.0#discover-agent-types",
    "wasmExportDiscoverTools:golem:tool/guest@0.1.0#discover-tools", "wasmExportDiscoverToolMiddlewares:golem:tool/tool-middleware-guest@0.1.0#discover-tool-middlewares",
  ])
  assert_true(updated.contains("discover-agent-types"))
  assert_true(updated.contains("discover-tools"))
  assert_true(updated.contains("discover-tool-middlewares"))
}
