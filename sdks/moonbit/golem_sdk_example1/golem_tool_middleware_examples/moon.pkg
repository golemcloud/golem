import {
  "golemcloud/golem_sdk/tool-core" @tool,
  "golemcloud/golem_sdk/tool-middleware" @toolMiddleware,
  "golemcloud/golem_sdk/gen-tool-middleware" @gen,
  "golemcloud/golem_sdk/schema", // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/schema_model" @model, // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/interface/golem/tool/common" @toolCommon, // Generated by golem_sdk_tools
}

supported_targets = "+wasm"

pkgtype(kind: "executable")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportAsyncInvokeToolMiddleware:[callback][async-lift]golem:tool/tool-middleware-guest@0.1.0#invoke-tool-middleware",
        "wasmExportDiscoverToolMiddlewares:golem:tool/tool-middleware-guest@0.1.0#discover-tool-middlewares",
        "wasmExportDiscoverToolMiddlewaresPostReturn:cabi_post_golem:tool/tool-middleware-guest@0.1.0#discover-tool-middlewares",
        "wasmExportGetToolMiddleware:golem:tool/tool-middleware-guest@0.1.0#get-tool-middleware",
        "wasmExportGetToolMiddlewarePostReturn:cabi_post_golem:tool/tool-middleware-guest@0.1.0#get-tool-middleware",
        "wasmExportInvokeToolMiddleware:[async-lift]golem:tool/tool-middleware-guest@0.1.0#invoke-tool-middleware",
      ],
      "heap-start-address": 16,
    },
  },
)
