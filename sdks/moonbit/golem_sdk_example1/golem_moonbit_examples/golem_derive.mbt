///|
///
impl @config.ConfigField for DatabaseConfig with fn collect_entries(path) {
  let entries : Array[@agents.AgentConfigDef] = []
  let fp0 = path.copy()
  fp0.push("host")
  entries.append(
    @config.local_entry(
      (@schema.TypeTag::{ } : @schema.TypeTag[String]),
      fp0,
      default_value="\"localhost\"",
    ),
  )
  let fp1 = path.copy()
  fp1.push("port")
  entries.append(
    @config.local_entry(
      (@schema.TypeTag::{ } : @schema.TypeTag[UInt32]),
      fp1,
      default_value="5432",
    ),
  )
  let fp2 = path.copy()
  fp2.push("timeout")
  entries.append(
    @config.local_entry(
      (@schema.TypeTag::{ } : @schema.TypeTag[UInt64]),
      fp2,
      default_value="30",
    ),
  )
  entries
}

