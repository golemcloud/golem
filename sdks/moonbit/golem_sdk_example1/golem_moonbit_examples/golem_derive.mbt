///|
///
impl @config.ConfigField for AppConfig with fn load(path) {
  let fp0 = path.copy()
  fp0.push("appName")
  let app_name : String = @config.load_config_value(fp0)
  let fp1 = path.copy()
  fp1.push("debug")
  let debug : Bool = @config.load_config_value(fp1)
  let fp2 = path.copy()
  fp2.push("apiKey")
  let api_key : @config.Secret[String] = @config.load_field(
    (@schema.TypeTag::{ } : @schema.TypeTag[@config.Secret[String]]),
    fp2,
  )
  let fp3 = path.copy()
  fp3.push("db")
  let db : DatabaseConfig = @config.load_field(
    (@schema.TypeTag::{ } : @schema.TypeTag[DatabaseConfig]),
    fp3,
  )
  { app_name, debug, api_key, db, }
}

///|
///
pub(all) struct DatabaseConfigOverride {
  host : String?
  port : UInt32?
  timeout : UInt64?
}

///|
///
pub fn DatabaseConfigOverride::empty() -> DatabaseConfigOverride {
  { host: None, port: None, timeout: None, }
}

///|
///
pub(all) struct AppConfigOverride {
  app_name : String?
  debug : Bool?
  db : DatabaseConfigOverride?
}

///|
///
pub fn AppConfigOverride::empty() -> AppConfigOverride {
  { app_name: None, debug: None, db: None, }
}

///|
///
pub fn collect_database_config_overrides(
  config : DatabaseConfigOverride,
  path : Array[String],
) -> Array[@common.TypedAgentConfigValue] raise @common.AgentError {
  let result : Array[@common.TypedAgentConfigValue] = []
  match config.host {
    Some(v) => {
      let p = path.copy()
      p.push("host")
      result.push(@rpc.typed_config_value(p, v))
    }
    None => ()
  }
  match config.port {
    Some(v) => {
      let p = path.copy()
      p.push("port")
      result.push(@rpc.typed_config_value(p, v))
    }
    None => ()
  }
  match config.timeout {
    Some(v) => {
      let p = path.copy()
      p.push("timeout")
      result.push(@rpc.typed_config_value(p, v))
    }
    None => ()
  }
  result
}

///|
///
pub impl @rpc.AgentConfigOverrides for DatabaseConfigOverride with fn typed_values(
  self,
) {
  collect_database_config_overrides(self, [])
}

///|
///
pub fn collect_app_config_overrides(
  config : AppConfigOverride,
  path : Array[String],
) -> Array[@common.TypedAgentConfigValue] raise @common.AgentError {
  let result : Array[@common.TypedAgentConfigValue] = []
  match config.app_name {
    Some(v) => {
      let p = path.copy()
      p.push("appName")
      result.push(@rpc.typed_config_value(p, v))
    }
    None => ()
  }
  match config.debug {
    Some(v) => {
      let p = path.copy()
      p.push("debug")
      result.push(@rpc.typed_config_value(p, v))
    }
    None => ()
  }
  match config.db {
    Some(v) => {
      let p = path.copy()
      p.push("db")
      result.append(collect_database_config_overrides(v, p))
    }
    None => ()
  }
  result
}

///|
///
pub impl @rpc.AgentConfigOverrides for AppConfigOverride with fn typed_values(
  self,
) {
  collect_app_config_overrides(self, [])
}
