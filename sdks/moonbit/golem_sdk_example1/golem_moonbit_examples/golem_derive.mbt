      default_value="30",
    ),
  )
  entries
}

///|
///
impl @config.ConfigField for DatabaseConfig with fn load(path) {
  let fp0 = path.copy()
  fp0.push("host")
  let host : String = @config.load_config_value(fp0)
  let fp1 = path.copy()
  fp1.push("port")
  let port : UInt32 = @config.load_config_value(fp1)
  let fp2 = path.copy()
  fp2.push("timeout")
  let timeout : UInt64 = @config.load_config_value(fp2)
  { host, port, timeout, }
}

