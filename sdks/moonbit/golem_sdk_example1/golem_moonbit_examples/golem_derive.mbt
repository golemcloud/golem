  "golem_moonbit_examples.TextOrImage"
}

///|
///
pub impl @multimodal.MultimodalModality for TextOrImage with fn multimodal_cases(
  b,
) {
  [
    @model.variant_case(
      "Text",
      payload=@schema.register_in_with(
        b,
        (@schema.TypeTag::{ } : @schema.TypeTag[String]),
      ),
    ),
    @model.variant_case(
      "Image",
      payload=@schema.register_in_with(
        b,
        (@schema.TypeTag::{ } : @schema.TypeTag[Bytes]),
      ),
    ),
  ]
}

///|
///
pub impl @multimodal.MultimodalModality for TextOrImage with fn to_modality_value(
  self,
) {
  match self {
    Text(v) => (0U, @schema.to_value_as(v))
    Image(v) => (1U, @schema.to_value_as(v))
  }
}

///|
///
pub impl @multimodal.MultimodalModality for TextOrImage with fn from_modality_value(
  case,
  payload,
) {
  match case {
    0 => Text(@schema.from_value_as(payload))
    1 => Image(@schema.from_value_as(payload))
    other => {
      let err = @schema.FromSchemaError::out_of_range(
        other, 2U, "golem_moonbit_examples.TextOrImage",
      )
      raise err
    }
  }
}

///|
///
pub impl @schema.IntoWire for TextOrImage with fn append_wire(self, encoder) {
  let value = match self {
    Text(field0) =>
      @types.VariantValuePayload::{
        case: 0U,
        payload: Some(@schema.IntoWire::append_wire(field0, encoder)),
      }
    Image(field0) =>
      @types.VariantValuePayload::{
        case: 1U,
        payload: Some(@schema.IntoWire::append_wire(field0, encoder)),
      }
  }
  encoder.push(@types.SchemaValueNode::VariantValue(value))
}

///|
///
pub impl @schema.IntoWire for TextOrImage with fn release_wire(self, releaser) {
  match self {
    Text(field0) => @schema.IntoWire::release_wire(field0, releaser)
    Image(field0) => @schema.IntoWire::release_wire(field0, releaser)
  }
}

///|
///
pub impl @schema.FromWire for TextOrImage with fn read_wire(tree, index) {
  let value = @schema.wire_variant(
    tree, index, 2, "golem_moonbit_examples.TextOrImage",
  )
  match value.case {
    0 =>
      Text(
        @schema.FromWire::read_wire(tree, @schema.wire_payload(value.payload)),
      )
    1 =>
      Image(
        @schema.FromWire::read_wire(tree, @schema.wire_payload(value.payload)),
      )
    _ => {
      let error = @schema.WireError::Invalid(
        "golem_moonbit_examples.TextOrImage: variant case out of range",
      )
      raise error
    }
  }
}

