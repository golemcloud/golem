import {
  "golemcloud/golem_sdk/logging",
  "golemcloud/golem_sdk/webhook",
  "golemcloud/golem_sdk/gen",
  "golemcloud/golem_sdk/agents",
  "golemcloud/golem_sdk/schema",
  "golemcloud/golem_sdk/interface/golem/agent/common",
  "golemcloud/golem_sdk/interface/golem/core/types",
  "golemcloud/golem_sdk/rpc",
  "golemcloud/golem_sdk/interface/golem/agent/host" @agentHost,
  "golemcloud/golem_sdk/async-core" @asyncCore,
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "golemcloud/golem_sdk/schema_model" @model,
  "golemcloud/golem_sdk/multimodal",
  "golemcloud/golem_sdk/config",
  "golemcloud/golem_sdk/tool",
  "golemcloud/golem_sdk/interface/golem/tool/common" @toolCommon,
  "golemcloud/golem_sdk/interface/wasi/clocks/system-clock" @systemClock,
  "golemcloud/golem_sdk/minimal-exports" @minimalExports,
  "golemcloud/golem_sdk/agent-exports" @agentExports, // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/gen/interface/golem/agent/guest" @agentGuest, // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/gen/interface/golem/api/save-snapshot" @saveSnapshot, // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/gen/interface/golem/api/load-snapshot" @loadSnapshot, // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/tool-exports" @toolExports, // Generated by golem_sdk_tools
  "golemcloud/golem_sdk/gen/interface/golem/tool/guest" @toolGuest, // Generated by golem_sdk_tools
}

pkgtype(kind: "executable")

supported_targets = "+wasm"

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportAsyncInitialize:[callback][async-lift]golem:agent/guest@2.0.0#initialize",
        "wasmExportAsyncInvokeGolemAgentGuest:[callback][async-lift]golem:agent/guest@2.0.0#invoke",
        "wasmExportAsyncInvokeGolemToolGuest:[callback][async-lift]golem:tool/guest@0.1.0#invoke",
        "wasmExportAsyncInvokeToolMiddleware:[callback][async-lift]golem:tool/tool-middleware-guest@0.1.0#invoke-tool-middleware",
        "wasmExportAsyncLoad:[callback][async-lift]golem:api/load-snapshot@1.5.0#load",
        "wasmExportAsyncSave:[callback][async-lift]golem:api/save-snapshot@1.5.0#save",
        "wasmExportDiscoverAgentTypes:golem:agent/guest@2.0.0#discover-agent-types",
        "wasmExportDiscoverAgentTypesPostReturn:cabi_post_golem:agent/guest@2.0.0#discover-agent-types",
        "wasmExportDiscoverToolMiddlewares:golem:tool/tool-middleware-guest@0.1.0#discover-tool-middlewares",
        "wasmExportDiscoverToolMiddlewaresPostReturn:cabi_post_golem:tool/tool-middleware-guest@0.1.0#discover-tool-middlewares",
        "wasmExportGetDefinition:golem:agent/guest@2.0.0#get-definition",
        "wasmExportGetDefinitionPostReturn:cabi_post_golem:agent/guest@2.0.0#get-definition",
        "wasmExportGetToolMiddleware:golem:tool/tool-middleware-guest@0.1.0#get-tool-middleware",
        "wasmExportGetToolMiddlewarePostReturn:cabi_post_golem:tool/tool-middleware-guest@0.1.0#get-tool-middleware",
        "wasmExportInitialize:[async-lift]golem:agent/guest@2.0.0#initialize",
        "wasmExportInvokeGolemAgentGuest:[async-lift]golem:agent/guest@2.0.0#invoke",
        "wasmExportInvokeGolemToolGuest:[async-lift]golem:tool/guest@0.1.0#invoke",
        "wasmExportInvokeToolMiddleware:[async-lift]golem:tool/tool-middleware-guest@0.1.0#invoke-tool-middleware",
        "wasmExportDiscoverTools:golem:tool/guest@0.1.0#discover-tools",
        "wasmExportDiscoverToolsPostReturn:cabi_post_golem:tool/guest@0.1.0#discover-tools",
        "wasmExportGetTool:golem:tool/guest@0.1.0#get-tool",
        "wasmExportGetToolPostReturn:cabi_post_golem:tool/guest@0.1.0#get-tool",
        "wasmExportLoad:[async-lift]golem:api/load-snapshot@1.5.0#load",
        "wasmExportSave:[async-lift]golem:api/save-snapshot@1.5.0#save",
      ],
      "heap-start-address": 16,
    },
  },
)
