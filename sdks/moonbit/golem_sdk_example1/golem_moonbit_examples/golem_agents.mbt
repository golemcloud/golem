      guard snapshot is @agents.SnapshotData::Json(bytes) else {
        return Err("Expected JSON snapshot")
      }
      let _ = context
      let json_str = @utf8.decode_lossy(bytes[:])
      let json = @json.parse(json_str) catch {
        e => return Err("Failed to parse snapshot JSON: " + e.to_string())
      }
      let agent : TaskManager = @json.from_json(json) catch {
        e => return Err("Failed to deserialize snapshot: " + e.to_string())
      }
      let constructed = @agents.ConstructedAgent::{
        raw: agent,
        snapshottable: Some(agent),
        snapshot_format: Some(@agents.SnapshotFormat::Json),
        multipart_snapshottable: None,
      }
      Ok(constructed)
    }),
  })
