test "principal reference text form matches the shared vectors" {
  check_round_trip(
    "spec example", "https://login.acme.example", "subject-123", "(\"https://login.acme.example\",\"subject-123\")",
  )
  check_round_trip(
    "agent subject", "https://id.golem.acme.example", "agent:0f3a5c21-8d4e-8b6f-9a1c-2e7d4b6a9c10/9b2d4e6f-1a3c-4d5e-8f70-6a8b9c0d1e2f",
    "(\"https://id.golem.acme.example\",\"agent:0f3a5c21-8d4e-8b6f-9a1c-2e7d4b6a9c10/9b2d4e6f-1a3c-4d5e-8f70-6a8b9c0d1e2f\")",
  )
  check_round_trip(
    "account subject", "https://id.golem.acme.example", "account:3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f",
    "(\"https://id.golem.acme.example\",\"account:3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f\")",
  )
  check_round_trip(
    "tool subject", "https://id.golem.acme.example", "tool:5e7f9a1b-2c3d-4e5f-8a6b-7c8d9e0f1a2b/report",
    "(\"https://id.golem.acme.example\",\"tool:5e7f9a1b-2c3d-4e5f-8a6b-7c8d9e0f1a2b/report\")",
  )
  check_round_trip(
    "github user", "https://github.com", "583231", "(\"https://github.com\",\"583231\")",
  )
  check_round_trip(
    "quote", "https://login.acme.example", "a\"b", "(\"https://login.acme.example\",\"a\\\"b\")",
  )
  check_round_trip(
    "backslash", "https://login.acme.example", "a\\b", "(\"https://login.acme.example\",\"a\\\\b\")",
  )
  check_round_trip(
    "quote and backslash at the ends", "\"", "\\", "(\"\\\"\",\"\\\\\")",
  )
  check_round_trip(
    "slash is never escaped", "https://login.acme.example/tenants/7/", "a/b", "(\"https://login.acme.example/tenants/7/\",\"a/b\")",
  )
  check_round_trip(
    "short escapes", "https://login.acme.example", "\u{8}\u{9}\u{a}\u{c}\u{d}", "(\"https://login.acme.example\",\"\\b\\t\\n\\f\\r\")",
  )
  check_round_trip(
    "other control characters", "https://login.acme.example", "\u{0}\u{1}\u{b}\u{e}\u{1b}\u{1f}",
    "(\"https://login.acme.example\",\"\\u0000\\u0001\\u000b\\u000e\\u001b\\u001f\")",
  )
  check_round_trip(
    "delete is not a control character here", "https://login.acme.example", "\u{7f}",
    "(\"https://login.acme.example\",\"\u{7f}\")",
  )
  check_round_trip(
    "latin text with an accent", "https://login.acme.example", "élève", "(\"https://login.acme.example\",\"élève\")",
  )
  check_round_trip(
    "decomposed accent stays decomposed", "https://login.acme.example", "élève",
    "(\"https://login.acme.example\",\"élève\")",
  )
  check_round_trip(
    "cjk text", "https://login.acme.example", "日本", "(\"https://login.acme.example\",\"日本\")",
  )
  check_round_trip(
    "emoji outside the basic plane", "https://login.acme.example", "😀", "(\"https://login.acme.example\",\"😀\")",
  )
  check_round_trip(
    "line and paragraph separators", "https://login.acme.example", "\u{2028}\u{2029}",
    "(\"https://login.acme.example\",\"\u{2028}\u{2029}\")",
  )
  check_round_trip(
    "comma and parentheses inside a string", "https://login.acme.example", "a,b)(\"c",
    "(\"https://login.acme.example\",\"a,b)(\\\"c\")",
  )
  check_round_trip(
    "quoted asterisk is a literal", "https://login.acme.example", "*", "(\"https://login.acme.example\",\"*\")",
  )
  check_round_trip(
    "spaces inside a string", "https://login.acme.example", " a b ", "(\"https://login.acme.example\",\" a b \")",
  )
  check_round_trip("empty strings", "", "", "(\"\",\"\")")
  check_round_trip(
    "every printable ascii character, including & < > quote backslash and slash",
    "https://login.acme.example", " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~",
    "(\"https://login.acme.example\",\" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\")",
  )
  check_round_trip(
    "every c1 control character is written as itself", "https://login.acme.example",
    "\u{80}\u{81}\u{82}\u{83}\u{84}\u{85}\u{86}\u{87}\u{88}\u{89}\u{8a}\u{8b}\u{8c}\u{8d}\u{8e}\u{8f}\u{90}\u{91}\u{92}\u{93}\u{94}\u{95}\u{96}\u{97}\u{98}\u{99}\u{9a}\u{9b}\u{9c}\u{9d}\u{9e}\u{9f}",
    "(\"https://login.acme.example\",\"\u{80}\u{81}\u{82}\u{83}\u{84}\u{85}\u{86}\u{87}\u{88}\u{89}\u{8a}\u{8b}\u{8c}\u{8d}\u{8e}\u{8f}\u{90}\u{91}\u{92}\u{93}\u{94}\u{95}\u{96}\u{97}\u{98}\u{99}\u{9a}\u{9b}\u{9c}\u{9d}\u{9e}\u{9f}\")",
  )
}

///|
test "principal reference parser refuses every non-canonical spelling" {
  check_rejected("empty input", "")
  check_rejected("no parentheses", "\"a\",\"b\"")
  check_rejected("leading space", " (\"a\",\"b\")")
  check_rejected("trailing space", "(\"a\",\"b\") ")
  check_rejected("space after the open parenthesis", "( \"a\",\"b\")")
  check_rejected("space after the comma", "(\"a\", \"b\")")
  check_rejected("space before the comma", "(\"a\" ,\"b\")")
  check_rejected("space before the close parenthesis", "(\"a\",\"b\" )")
  check_rejected("single quotes", "('a','b')")
  check_rejected("missing quote after the issuer", "(\"a,\"b\")")
  check_rejected("missing quote after the subject", "(\"a\",\"b)")
  check_rejected("one element", "(\"a\")")
  check_rejected("third element", "(\"a\",\"b\",\"c\")")
  check_rejected("unquoted asterisk as issuer", "(*,\"b\")")
  check_rejected("unquoted asterisk as subject", "(\"a\",*)")
  check_rejected("trailing text", "(\"a\",\"b\")x")
  check_rejected("second close parenthesis", "(\"a\",\"b\"))")
  check_rejected("leading text", "x(\"a\",\"b\")")
  check_rejected("escaped slash", "(\"a\",\"\\/\")")
  check_rejected(
    "unicode escape of a printable letter", "(\"a\",\"\\u0062ob\")",
  )
  check_rejected("unicode escape of a quote", "(\"a\",\"\\u0022\")")
  check_rejected("unicode escape of a backslash", "(\"a\",\"\\u005c\")")
  check_rejected("unicode escape of a newline", "(\"a\",\"\\u000a\")")
  check_rejected("unicode escape of a tab", "(\"a\",\"\\u0009\")")
  check_rejected("uppercase hex", "(\"a\",\"\\u001F\")")
  check_rejected("uppercase u in a unicode escape", "(\"a\",\"\\U0001\")")
  check_rejected("unicode escape of non-ascii text", "(\"a\",\"\\u00e9\")")
  check_rejected("surrogate pair escape", "(\"a\",\"\\ud83d\\ude00\")")
  check_rejected("short unicode escape", "(\"a\",\"\\u01\")")
  check_rejected("unknown escape", "(\"a\",\"\\x41\")")
  check_rejected("escaped single quote", "(\"a\",\"\\'\")")
  check_rejected("raw tab inside a string", "(\"a\",\"\u{9}\")")
  check_rejected("raw newline inside a string", "(\"a\",\"\u{a}\")")
  check_rejected("raw nul inside a string", "(\"a\",\"\u{0}\")")
  check_rejected("backslash at the end of the input", "(\"a\",\"\\")
  check_rejected(
    "unicode escape of a letter above U+00FF", "(\"a\",\"\\u0100\")",
  )
  check_rejected("unicode escape of the line separator", "(\"a\",\"\\u2028\")")
  check_rejected(
    "unicode escape of the paragraph separator", "(\"a\",\"\\u2029\")",
  )
  check_rejected("unicode escape of U+FFFF", "(\"a\",\"\\uffff\")")
  check_rejected("escaped lone high surrogate", "(\"a\",\"\\ud800\")")
  check_rejected("escaped lone low surrogate", "(\"a\",\"\\udfff\")")
  check_rejected(
    "escaped high surrogate followed by a plain letter", "(\"a\",\"\\ud83dx\")",
  )
}
