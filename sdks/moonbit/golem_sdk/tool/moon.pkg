import {
  "golemcloud/golem_sdk/async-core",
  "golemcloud/golem_sdk/interface/golem/core/types",
  "golemcloud/golem_sdk/interface/golem/tool/common" @toolCommon,
  "golemcloud/golem_sdk/interface/golem/tool/host" @toolHost,
  "golemcloud/golem_sdk/interface/golem/tool/streams" @toolStreams,
  "golemcloud/golem_sdk/schema",
  "golemcloud/golem_sdk/schema_model" @model,
  "golemcloud/golem_sdk/schema_model_host" @model_host,
  "golemcloud/golem_sdk/tool-core" @toolCore,
}

import {
  "golemcloud/golem_sdk/internal/permission_card" @card,
  "golemcloud/golem_sdk/internal/test_support",
} for "wbtest"

// Invocation and stream outcomes remain data that callers can collect separately.

warnings = "-44-result_error_return"

supported_targets = "+wasm"
