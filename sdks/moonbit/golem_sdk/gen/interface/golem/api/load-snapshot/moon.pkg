import {
  "golemcloud/golem_sdk/async-core",
  "golemcloud/golem_sdk/gen/wit_bindgen_export_lower",
  "golemcloud/golem_sdk/interface/golem/api/host",
  "golemcloud/golem_sdk/interface/golem/core/types",
  "golemcloud/golem_sdk/schema_model" @model,
}

warnings = "-44-unused_value-declaration_unimplemented"

supported_targets = "+wasm+wasm-gc"

// BEGIN generated backend
#cfg(target = "wasm-gc")
import {
  "golemcloud/golem_sdk/gen/cabi" @witCabi,
}
// END generated backend

// BEGIN generated backend
options(
  targets: {
    "ffi.mbt": ["wasm"],
    "ffi_gc.mbt": ["wasm-gc"],
  },
)
// END generated backend
