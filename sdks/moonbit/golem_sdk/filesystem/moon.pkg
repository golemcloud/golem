import {
  "golemcloud/golem_sdk/async-core" @asyncCore,
  "golemcloud/golem_sdk/interface/wasi/filesystem/preopens",
  "golemcloud/golem_sdk/interface/wasi/filesystem/types",
  "moonbitlang/core/encoding/utf8",
}

// Filesystem helpers preserve WASI success/error values as Result data.
warnings = "-result_error_return"

supported_targets = "+wasm"
