.DS_Store
target/
.mooncakes/
.moonagent/
_build/
/.wit-bindgen-version

# Generated by scripts/regen-bindings.sh. Hand-maintained files below these
# roots remain tracked and are overlaid after each regeneration.
/async-core/**
/interface/**
/world/**
/gen/**

# Keep future hand-maintained overlays visible to Git. These patterns must
# match the file classes preserved by scripts/regen-bindings.sh.
!/async-core/**/
!/interface/**/
!/world/**/
!/gen/**/
!/**/moon.pkg
!/**/stub.mbt
!/**/stream_transfer.mbt
!/**/*_test.mbt
!/**/*_wbtest.mbt
