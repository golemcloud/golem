import {
  "golemcloud/golem_sdk/interface/golem/agent/durable-streams",
  "golemcloud/golem_sdk/interface/golem/core/types",
  "golemcloud/golem_sdk/interface/wasi/clocks/monotonic-clock" @clock,
  "golemcloud/golem_sdk/api",
  "golemcloud/golem_sdk/async-core",
  "golemcloud/golem_sdk/schema",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

import {
  "golemcloud/golem_sdk/gen",
} for "wbtest"

supported_targets = "+wasm+wasm-gc"

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
