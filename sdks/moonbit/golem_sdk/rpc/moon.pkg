import {
  "golemcloud/golem_sdk/interface/golem/core/types",
  "golemcloud/golem_sdk/interface/golem/agent/host" @agentHost,
  "golemcloud/golem_sdk/interface/golem/agent/common",
  "golemcloud/golem_sdk/interface/wasi/clocks/system-clock" @systemClock,
  "golemcloud/golem_sdk/internal/scope_card",
  "golemcloud/golem_sdk/permissions",
  "golemcloud/golem_sdk/schema",
  "golemcloud/golem_sdk/schema_model" @model,
}

import {
  "golemcloud/golem_sdk/internal/test_support",
  "golemcloud/golem_sdk/gen",
  "moonbitlang/core/encoding/utf16",
} for "wbtest"

// Test host buffers use the same allocator as the generated bindings.

warnings = "-44"

supported_targets = "+wasm+wasm-gc"

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
