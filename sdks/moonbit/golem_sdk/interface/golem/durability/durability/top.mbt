      index194 < mbt_ffi_load32(return_area + 28)
      index194 = index194 + 1 {
    let iter_base = mbt_ffi_load32(return_area + 24) + index194 * 144

    let lifted179 = match mbt_ffi_load8_u(iter_base + 0) {
      0 => @types.SchemaTypeBody::RefType(mbt_ffi_load32(iter_base + 8))
