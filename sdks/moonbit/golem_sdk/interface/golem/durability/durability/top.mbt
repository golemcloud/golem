  wasmImportStaticLiveCustomDurableInvocationFinish(
    handle,
    address359,
    response.graph.type_nodes.length(),
    address365,
    response.graph.defs.length(),
    response.graph.root,
    address442,
    response.value.value_nodes.length(),
    response.value.root,
    if forced_commit {
      1
    } else {
      0
    },
  )
  mbt_ffi_free(address359)
  mbt_ffi_free(address365)
  mbt_ffi_free(address442)

  cleanup_list.each(mbt_ffi_free)
}

///|
/// Observes a function call (produces logs and metrics)
pub fn observe_function_call(iface : String, function : String) -> Unit {
  let ptr = mbt_ffi_str2ptr(iface)

  let ptr0 = mbt_ffi_str2ptr(function)
  wasmImportObserveFunctionCall(ptr, iface.length(), ptr0, function.length())
  mbt_ffi_free(ptr)
  mbt_ffi_free(ptr0)
}

///|
/// Opens a custom durable invocation.
///
/// The executor allocates a deterministic identity synchronously when the call begins. A fresh
/// or incomplete invocation returns an owned `live-custom-durable-invocation`. A completed
/// invocation returns `replayed` with its recorded response.
pub fn begin_custom_durable_invocation(
  function_name : String,
  request : @types.TypedSchemaValue,
  function_type : @oplog.WrappedFunctionType,
) -> CustomDurableInvocation {
  let cleanup_list : Array[Int] = []

  let ptr = mbt_ffi_str2ptr(function_name)

  let address360 = mbt_ffi_malloc(request.graph.type_nodes.length() * 144)
  for index361 = 0
      index361 < request.graph.type_nodes.length()
      index361 = index361 + 1 {
    let iter_elem : @types.SchemaTypeNode = request.graph.type_nodes[index361]
    let iter_base = address360 + index361 * 144

    match iter_elem.body {
      RefType(payload) => {
        mbt_ffi_store8(iter_base + 0, 0)
        mbt_ffi_store32(iter_base + 8, payload)

        ()
      }
      BoolType => {
        mbt_ffi_store8(iter_base + 0, 1)

        ()
      }
      S8Type(payload1) => {
        mbt_ffi_store8(iter_base + 0, 2)

        match payload1 {
          None => {
            mbt_ffi_store8(iter_base + 8, 0)

