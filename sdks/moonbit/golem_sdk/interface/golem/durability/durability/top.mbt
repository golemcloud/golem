                  0 =>
                    @types.NumericBound::Signed(mbt_ffi_load64(iter_base + 56))
                  1 =>
                    @types.NumericBound::Unsigned(
                      mbt_ffi_load64(iter_base + 56).reinterpret_as_uint64(),
                    )
                  2 =>
                    @types.NumericBound::FloatBits(
                      mbt_ffi_load64(iter_base + 56).reinterpret_as_uint64(),
