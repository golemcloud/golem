                  }
                  UrlValue(payload55) => {
                        mbt_ffi_store8((iter_base) + 0, (26))

                        let ptr56 = mbt_ffi_str2ptr(payload55)
                        mbt_ffi_store32((iter_base) + 12, payload55.length())
                        mbt_ffi_store32((iter_base) + 8, ptr56)
                        cleanup_list.push(ptr56)

                        ()
                  }
                  UuidValue(payload57) => {
                        mbt_ffi_store8((iter_base) + 0, (27))
                        mbt_ffi_store64((iter_base) + 8, ((payload57).high_bits).reinterpret_as_int64())
                        mbt_ffi_store64((iter_base) + 16, ((payload57).low_bits).reinterpret_as_int64())

                        ()
                  }
                  DatetimeValue(payload58) => {
                        mbt_ffi_store8((iter_base) + 0, (28))
                        mbt_ffi_store64((iter_base) + 8, (payload58).seconds)
                        mbt_ffi_store32((iter_base) + 16, ((payload58).nanoseconds).reinterpret_as_int())

                        ()
                  }
                  DurationValue(payload59) => {
                        mbt_ffi_store8((iter_base) + 0, (29))
                        mbt_ffi_store64((iter_base) + 8, (payload59).nanoseconds)

                        ()
                  }
                  QuantityValueNode(payload60) => {
                        mbt_ffi_store8((iter_base) + 0, (30))
                        mbt_ffi_store64((iter_base) + 8, (payload60).mantissa)
                        mbt_ffi_store32((iter_base) + 16, (payload60).scale)

                        let ptr61 = mbt_ffi_str2ptr((payload60).unit)
                        mbt_ffi_store32((iter_base) + 24, (payload60).unit.length())
                        mbt_ffi_store32((iter_base) + 20, ptr61)
                        cleanup_list.push(ptr61)

                        ()
                  }
                  UnionValue(payload62) => {
                        mbt_ffi_store8((iter_base) + 0, (31))

                        let ptr63 = mbt_ffi_str2ptr((payload62).tag)
                        mbt_ffi_store32((iter_base) + 12, (payload62).tag.length())
                        mbt_ffi_store32((iter_base) + 8, ptr63)
                        mbt_ffi_store32((iter_base) + 16, (payload62).body)
                        cleanup_list.push(ptr63)

                        ()
                  }
                  SecretValue(payload64) => {
                        mbt_ffi_store8((iter_base) + 0, (32))

                        let @types.Secret(handle65) = payload64
                        mbt_ffi_store32((iter_base) + 8, handle65)

                        ()
                  }
                  QuotaTokenHandle(payload66) => {
                        mbt_ffi_store8((iter_base) + 0, (33))

                        let @types.QuotaToken(handle67) = payload66
                        mbt_ffi_store32((iter_base) + 8, handle67)

                        ()
                  }
                  PermissionCardHandle(payload68) => {
                        mbt_ffi_store8((iter_base) + 0, (34))

                        let @types.PermissionCard(handle69) = payload68
                        mbt_ffi_store32((iter_base) + 8, handle69)

                        ()
                  }
                  StreamValue(payload70) => {
                        mbt_ffi_store8((iter_base) + 0, (35))

                        let @types.SchemaValueStream(handle71) = payload70
                        mbt_ffi_store32((iter_base) + 8, handle71)

                        ()
                  }
            }

      }

      let (lowered, lowered77) = match (scope_card) {
            None => {

                  ((0), 0)
            }
            Some(payload75) => {

                  let @types.PermissionCard(handle76) = payload75

                  ((1), handle76)
            }
      }
      let return_area = mbt_ffi_malloc(20)
      wasmImportMethodWasmRpcAsyncInvokeAndAwait(handle, ptr, method_name.length(), address72, ((input).value_nodes).length(), (input).root, lowered, lowered77, return_area);

      let result = mbt_ffi_ptr2str(mbt_ffi_load32((return_area) + 0), mbt_ffi_load32((return_area) + 4))

      let result78 = mbt_ffi_ptr2str(mbt_ffi_load32((return_area) + 8), mbt_ffi_load32((return_area) + 12))
      let ret = AsyncInvocationWithMetadata::{metadata : InvocationMetadata::{agent_id : result, idempotency_key : result78}, future : FutureInvokeResult::FutureInvokeResult(mbt_ffi_load32((return_area) + 16))}
      mbt_ffi_free(ptr)
      mbt_ffi_free(address72)
      mbt_ffi_free(return_area)

      cleanup_list.each(mbt_ffi_free)
      return ret

}
///|
/// Schedules an invocation for later and returns its final identity.
pub fn WasmRpc::schedule_invocation(self : WasmRpc, scheduled_time : @system-clock.Instant, method_name : String, input : @types.SchemaValueTree, scope_card : @types.PermissionCard?) -> Result[ScheduledInvocationReceipt, RpcError] {
      let cleanup_list : Array[Int] = []

      let WasmRpc(handle) = self

