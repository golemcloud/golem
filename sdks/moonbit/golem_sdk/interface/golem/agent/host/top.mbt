      let address362 = mbt_ffi_malloc(((expected).type_nodes).length() * 144);
      for index363 = 0; index363 < ((expected).type_nodes).length(); index363 = index363 + 1 {
            let iter_elem : @types.SchemaTypeNode = ((expected).type_nodes)[(index363)]
