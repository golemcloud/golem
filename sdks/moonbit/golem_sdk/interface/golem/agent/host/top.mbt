      wasmImportCreateWebhook((((((promise_id).agent_id).component_id).uuid).high_bits).reinterpret_as_int64(), (((((promise_id).agent_id).component_id).uuid).low_bits).reinterpret_as_int64(), ptr, ((promise_id).agent_id).agent_id.length(), ((promise_id).oplog_idx).reinterpret_as_int64(), return_area);

