      }

      let (lowered, lowered76) = match (scope_card) {
            None => {

                  ((0), 0)
            }
            Some(payload74) => {

                  let @types.PermissionCard(handle75) = payload74

                  ((1), handle75)
            }
      }
      let return_area = mbt_ffi_malloc(20)
      wasmImportMethodWasmRpcAsyncInvokeAndAwait(handle, ptr, method_name.length(), address71, ((input).value_nodes).length(), (input).root, lowered, lowered76, return_area);

      let result = mbt_ffi_ptr2str(mbt_ffi_load32((return_area) + 0), mbt_ffi_load32((return_area) + 4))

      let result77 = mbt_ffi_ptr2str(mbt_ffi_load32((return_area) + 8), mbt_ffi_load32((return_area) + 12))
      let ret = AsyncInvocationWithMetadata::{metadata : InvocationMetadata::{agent_id : result, idempotency_key : result77}, future : FutureInvokeResult::FutureInvokeResult(mbt_ffi_load32((return_area) + 16))}
      mbt_ffi_free(ptr)
      mbt_ffi_free(address71)
      mbt_ffi_free(return_area)

      cleanup_list.each(mbt_ffi_free)
