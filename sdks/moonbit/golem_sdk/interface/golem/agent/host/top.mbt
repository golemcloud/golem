///|
/// Invokes a remote method with the given parameters, and awaits the result.
///
/// `input` encodes the method's parameter list. The returned result is
/// `none` for a `unit` output and `some(value)` for a `single` output.
pub fn WasmRpc::invoke_and_await(self : WasmRpc, method_name : String, input : @types.SchemaValueTree, scope_card : @types.PermissionCard?) -> Result[InvocationResultWithMetadata, RpcError] {
      let cleanup_list : Array[Int] = []

      let WasmRpc(handle) = self

      let ptr = mbt_ffi_str2ptr(method_name)

      let address71 = mbt_ffi_malloc(((input).value_nodes).length() * 32);
      for index72 = 0; index72 < ((input).value_nodes).length(); index72 = index72 + 1 {
            let iter_elem : @types.SchemaValueNode = ((input).value_nodes)[(index72)]
            let iter_base = address71 + (index72 * 32);

            match iter_elem {
                  BoolValue(payload) => {
                        mbt_ffi_store8((iter_base) + 0, (0))
                        mbt_ffi_store8((iter_base) + 8, (if payload { 1 } else { 0 }))

                        ()
