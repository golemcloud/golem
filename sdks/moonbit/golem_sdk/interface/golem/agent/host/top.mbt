                                                mbt_ffi_store32((iter_base) + 16, payload39)

                                                ()
                                          }
                                    }

                                    ()
                              }
                              ErrValue(payload40) => {
                                    mbt_ffi_store8((iter_base) + 8, (1))

                                    match (payload40) {
                                          None => {
                                                mbt_ffi_store8((iter_base) + 12, (0))

                                                ()
                                          }
                                          Some(payload42) => {
