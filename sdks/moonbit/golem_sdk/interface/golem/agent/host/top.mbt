                  PathValue(payload53) => {
                        mbt_ffi_store8((iter_base) + 0, (25))

                        let ptr54 = mbt_ffi_str2ptr(payload53)
                        mbt_ffi_store32((iter_base) + 12, payload53.length())
                        mbt_ffi_store32((iter_base) + 8, ptr54)
                        cleanup_list.push(ptr54)

