                                          S64Value(payload15) => {
                                                mbt_ffi_store8((iter_base) + 0, (4))
                                                mbt_ffi_store64((iter_base) + 8, payload15)

                                                ()
                                          }
                                          U8Value(payload16) => {
                                                mbt_ffi_store8((iter_base) + 0, (5))
                                                mbt_ffi_store8((iter_base) + 8, (payload16).to_int())

                                                ()
