          iter_base + 208,
          payload.instance_id.low_bits.reinterpret_as_int64(),
        )
        cleanup_list.push(ptr0)
        cleanup_list.push(address)
        cleanup_list.push(address6)
        cleanup_list.push(address84)

        ()
      }
      Start(payload88) => {
        mbt_ffi_store8(iter_base + 8, 1)
        mbt_ffi_store64(iter_base + 16, payload88.timestamp.seconds)
        mbt_ffi_store32(
          iter_base + 24,
          payload88.timestamp.nanoseconds.reinterpret_as_int(),
        )

        match payload88.parent_start_index {
          None => {
            mbt_ffi_store8(iter_base + 32, 0)

            ()
          }
