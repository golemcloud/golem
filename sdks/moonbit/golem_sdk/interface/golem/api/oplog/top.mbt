                                          U16Value(payload17) => {
                                                mbt_ffi_store8((iter_base) + 0, (6))
                                                mbt_ffi_store16((iter_base) + 8, (payload17).reinterpret_as_int())

                                                ()
                                          }
                                          U32Value(payload18) => {
                                                mbt_ffi_store8((iter_base) + 0, (7))
                                                mbt_ffi_store32((iter_base) + 8, (payload18).reinterpret_as_int())

                                                ()
                                          }
                                          U64Value(payload19) => {
                                                mbt_ffi_store8((iter_base) + 0, (8))
                                                mbt_ffi_store64((iter_base) + 8, (payload19).reinterpret_as_int64())

                                                ()
