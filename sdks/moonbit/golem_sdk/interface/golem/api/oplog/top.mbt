pub(all) struct RawHostStreamFrameParameters {
  timestamp : @system-clock.Instant
  parent_start_index : UInt64
  kind : HostStreamKind
  payload : OplogPayload
} derive(Debug, Eq)

///|
pub(all) enum DurableStreamOutcome {
  SUCCESS
  ERROR
} derive(Debug, Eq)

///|
pub fn DurableStreamOutcome::ordinal(self : DurableStreamOutcome) -> Int {
  match self {
    SUCCESS => 0
    ERROR => 1
  }
}

///|
pub fn DurableStreamOutcome::from(self : Int) -> DurableStreamOutcome {
  match self {
    0 => SUCCESS
    1 => ERROR
    _ => panic()
  }
}

///|
pub(all) enum DurableStreamEventSummary {
  Registered
  Items(UInt64)
  End(DurableStreamOutcome)
  Cancelled
  SessionResult
  SessionFinished(DurableStreamOutcome)
  SessionCancellation
  SessionExpired
} derive(Debug, Eq)

///|
/// A raw durable-stream producer record, stored inline or in external payload storage.
pub(all) struct RawDurableStreamRecordParameters {
  timestamp : @system-clock.Instant
  record : OplogPayload
  summary : DurableStreamEventSummary?
} derive(Debug, Eq)

