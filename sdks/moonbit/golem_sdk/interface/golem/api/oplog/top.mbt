        cleanup_list.push(address6)
        cleanup_list.push(address82)

        ()
      }
      Start(payload86) => {
        mbt_ffi_store8(iter_base + 8, 1)
        mbt_ffi_store64(iter_base + 16, payload86.timestamp.seconds)
        mbt_ffi_store32(
          iter_base + 24,
          payload86.timestamp.nanoseconds.reinterpret_as_int(),
        )

        match payload86.parent_start_index {
          None => {
            mbt_ffi_store8(iter_base + 32, 0)

            ()
          }
          Some(payload88) => {
            mbt_ffi_store8(iter_base + 32, 1)
            mbt_ffi_store64(iter_base + 40, payload88.reinterpret_as_int64())

            ()
          }
        }

