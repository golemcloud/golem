///|
pub(all) struct GetOplog(Int) derive(Show, Eq)

///|
/// Drops a resource handle.
pub fn GetOplog::drop(self : GetOplog) -> Unit {
  let GetOplog(resource) = self
  wasmImportResourceDropGetOplog(resource)
}

