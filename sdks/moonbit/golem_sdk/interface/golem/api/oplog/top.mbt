                                          S8Value(payload12) => {
                                                mbt_ffi_store8((iter_base) + 0, (1))
                                                mbt_ffi_store8((iter_base) + 8, mbt_ffi_extend8(payload12))

                                                ()
                                          }
                                          S16Value(payload13) => {
                                                mbt_ffi_store8((iter_base) + 0, (2))
