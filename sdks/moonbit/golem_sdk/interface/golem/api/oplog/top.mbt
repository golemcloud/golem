                  let iter_elem : Int = payload35[index37]
                  let iter_base = address36 + index37 * 4
                  mbt_ffi_store32(iter_base + 0, iter_elem)
                }
                mbt_ffi_store32(iter_base + 12, payload35.length())
                mbt_ffi_store32(iter_base + 8, address36)
                cleanup_list.push(address36)

                ()
              }
              ListValue(payload38) => {
                mbt_ffi_store8(iter_base + 0, 18)

                let address39 = mbt_ffi_malloc(payload38.length() * 4)
                for index40 = 0
