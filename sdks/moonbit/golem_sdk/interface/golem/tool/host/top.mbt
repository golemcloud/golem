              Some(payload47) => {
                mbt_ffi_store8(iter_base + 64, 1)

                let ptr48 = mbt_ffi_str2ptr(payload47)
                mbt_ffi_store32(iter_base + 72, payload47.length())
                mbt_ffi_store32(iter_base + 68, ptr48)
                cleanup_list.push(ptr48)

