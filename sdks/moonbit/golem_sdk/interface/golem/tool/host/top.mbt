                mbt_ffi_store32(iter_base + 68, ptr32)
                cleanup_list.push(ptr32)

                ()
              }
            }

            ()
          }
        }

        ()
      }
      S32Type(payload33) => {
        mbt_ffi_store8(iter_base + 0, 4)

        match payload33 {
          None => {
            mbt_ffi_store8(iter_base + 8, 0)

