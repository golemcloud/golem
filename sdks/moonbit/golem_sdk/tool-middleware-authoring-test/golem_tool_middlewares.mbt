    }
    match Policy::stdout(__golem_expected) {
      Ok(__golem_result) =>
        return __golem_invocation.typed_result_stdout(__golem_result)
      Err(__golem_error) =>
        return Err(
          __golem_invocation.encode_handler_error(__golem_error, fn(_) {
            Err("infallible middleware handler returned a custom tool error")
          }),
        )
    }
  }
  if __golem_def.command_index_by_path(["abandon-stdout"]) ==
    Some(__golem_index) {
    if __golem_invocation.stdin() is Some(_) {
      return Err(
        @toolMiddleware.ToolInvokeError::InvalidInput(
          "tool invocation contained an unexpected stdin stream",
        ),
      )
    }
    let __golem_expected = PresentedUnderlying::{
      underlying: __golem_underlying,
    }
    match Policy::abandon_stdout(__golem_expected) {
      Ok(__golem_result) =>
        return __golem_invocation.typed_result_stdout(__golem_result)
      Err(__golem_error) =>
        return Err(
          __golem_invocation.encode_handler_error(__golem_error, fn(_) {
