import {
  "golemcloud/golem_sdk/interface/golem/core/types",
  "golemcloud/golem_sdk/internal/permission_card" @card,
  "golemcloud/golem_sdk/permissions",
}

import {
  "golemcloud/golem_sdk/gen",
} for "test"

warnings = "-44"

supported_targets = "+wasm+wasm-gc"

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
