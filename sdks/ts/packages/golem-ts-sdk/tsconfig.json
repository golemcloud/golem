{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*", "types"],
  "exclude": ["node_modules"]
}
