{
  "name": "@golemcloud/golem-ts-sdk",
  "type": "module",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "types",
    "dist",
    "wasm"
  ],
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./schema": {
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    },
    "./reflection": {
      "import": "./dist/reflection.mjs",
      "types": "./dist/reflection.d.mts"
    },
    "./middleware": {
      "import": "./dist/middleware.mjs",
      "types": "./dist/middleware.d.mts"
    }
  },
  "typesVersions": {
    "*": {
      "agentic-guest": [
        "types/exports.d.ts"
      ],
      "golem:agent/common@2.0.0": [
        "types/golem_agent_2_0_0_common.d.ts"
      ],
      "golem:agent/host@2.0.0": [
        "types/golem_agent_2_0_0_host.d.ts"
      ],
      "golem:core/types@2.0.0": [
        "types/golem_core_2_0_0_types.d.ts"
      ],
      "golem:rdbms/ignite2@1.5.0": [
        "types/golem_rdbms_1_5_0_ignite2.d.ts"
      ]
    }
  },
  "scripts": {
    "bench": "vitest bench",
    "bench:quickjs": "node ./scripts/bench-quickjs.mjs",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.mjs --fix",
    "generate-dts": "node ./scripts/generate-dts.mjs",
    "build": "pnpm run generate-dts && rollup --failAfterWarnings -c",
    "clean": "node ./scripts/clean.mjs",
    "clean-test-data": "node ../../scripts/clean-test-data.mjs",
    "test": "pnpm run typecheck && pnpm run clean-test-data && vitest run",
    "typecheck": "pnpm run build && tsc --project tsconfig.type-tests.json",
    "dev": "rollup -c -w",
    "generate-agent-template": "node ./scripts/generate-agent-template.mjs",
    "compile-agent-template": "node ./scripts/compile-agent-templates.mjs",
    "copy-agent-template": "node ./scripts/copy-agent-template.mjs",
    "build-agent-template": "pnpm run generate-agent-template && pnpm run compile-agent-template && pnpm run copy-agent-template"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "description": "",
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "arktype": "^2.1.0",
    "effect": "^3.10.0",
    "valibot": "^1.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "fast-check": "^4.2.0",
    "ms": "^2.1.3",
    "prettier": "^3.6.2",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4",
    "zod": "^4.4.3",
    "zod3": "npm:zod@^3.24.0"
  },
  "private": false,
  "repository": "https://github.com/golemcloud/golem"
}
