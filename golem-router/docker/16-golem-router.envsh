#!/bin/sh
# Sets the defaults of the golem-router variables, which the entrypoint of the nginx image then
# replaces in the configuration template.

golem_router_fail() {
  echo "golem-router: $*" >&2
  exit 1
}

[ -n "${GOLEM_ROUTER_MANAGEMENT_HOST:-}" ] ||
  golem_router_fail "GOLEM_ROUTER_MANAGEMENT_HOST must be set to the host name of the management API"
[ -n "${GOLEM_ROUTER_REGISTRY_SERVICE_HOST:-}" ] ||
  golem_router_fail "GOLEM_ROUTER_REGISTRY_SERVICE_HOST must be set"
[ -n "${GOLEM_ROUTER_WORKER_SERVICE_HOST:-}" ] ||
  golem_router_fail "GOLEM_ROUTER_WORKER_SERVICE_HOST must be set"

# The name servers of /etc/resolv.conf, which the nginx image reads into NGINX_LOCAL_RESOLVERS.
: "${GOLEM_ROUTER_RESOLVER:=${NGINX_LOCAL_RESOLVERS:-}}"
[ -n "${GOLEM_ROUTER_RESOLVER}" ] ||
  golem_router_fail "GOLEM_ROUTER_RESOLVER must be set, because /etc/resolv.conf has no name server"
: "${GOLEM_ROUTER_RESOLVER_VALID:=10s}"
: "${GOLEM_ROUTER_PORT:=80}"
: "${GOLEM_ROUTER_REGISTRY_SERVICE_PORT:=8081}"
: "${GOLEM_ROUTER_WORKER_SERVICE_PORT:=9005}"
: "${GOLEM_ROUTER_WORKER_SERVICE_CUSTOM_REQUEST_PORT:=9006}"
: "${GOLEM_ROUTER_CLIENT_MAX_BODY_SIZE:=1g}"
: "${GOLEM_ROUTER_STREAM_TIMEOUT:=1h}"

# Listen on IPv6 too where the kernel supports it.
GOLEM_ROUTER_LISTEN="listen ${GOLEM_ROUTER_PORT};"
GOLEM_ROUTER_LISTEN_DEFAULT="listen ${GOLEM_ROUTER_PORT} default_server;"
if [ -f /proc/net/if_inet6 ]; then
  GOLEM_ROUTER_LISTEN="${GOLEM_ROUTER_LISTEN} listen [::]:${GOLEM_ROUTER_PORT};"
  GOLEM_ROUTER_LISTEN_DEFAULT="${GOLEM_ROUTER_LISTEN_DEFAULT} listen [::]:${GOLEM_ROUTER_PORT} default_server;"
fi

export GOLEM_ROUTER_MANAGEMENT_HOST GOLEM_ROUTER_REGISTRY_SERVICE_HOST GOLEM_ROUTER_WORKER_SERVICE_HOST \
  GOLEM_ROUTER_RESOLVER GOLEM_ROUTER_RESOLVER_VALID GOLEM_ROUTER_PORT \
  GOLEM_ROUTER_REGISTRY_SERVICE_PORT GOLEM_ROUTER_WORKER_SERVICE_PORT \
  GOLEM_ROUTER_WORKER_SERVICE_CUSTOM_REQUEST_PORT GOLEM_ROUTER_CLIENT_MAX_BODY_SIZE \
  GOLEM_ROUTER_STREAM_TIMEOUT GOLEM_ROUTER_LISTEN GOLEM_ROUTER_LISTEN_DEFAULT
