# The nginx configuration of the golem-router image. The image's entrypoint replaces the
# GOLEM_ROUTER_ variables; see golem-router/docker/16-golem-router.envsh for their defaults.
#
# Requests for the management host reach the registry service and the management API of the
# worker service. Requests for every other host reach the custom request port of the worker
# service, which serves HTTP API and MCP deployments by domain.

resolver ${GOLEM_ROUTER_RESOLVER} valid=${GOLEM_ROUTER_RESOLVER_VALID};

client_max_body_size ${GOLEM_ROUTER_CLIENT_MAX_BODY_SIZE};

# Each upstream re-resolves its host name, so a service that restarts with a new address stays
# reachable, and the router starts before the services can be resolved.
upstream golem-registry-service {
    zone golem-registry-service 64k;
    server ${GOLEM_ROUTER_REGISTRY_SERVICE_HOST}:${GOLEM_ROUTER_REGISTRY_SERVICE_PORT} resolve max_fails=0;
    keepalive 16;
}

upstream golem-worker-service {
    zone golem-worker-service 64k;
    server ${GOLEM_ROUTER_WORKER_SERVICE_HOST}:${GOLEM_ROUTER_WORKER_SERVICE_PORT} resolve max_fails=0;
    keepalive 16;
}

upstream golem-worker-service-custom-request {
    zone golem-worker-service-custom-request 64k;
    server ${GOLEM_ROUTER_WORKER_SERVICE_HOST}:${GOLEM_ROUTER_WORKER_SERVICE_CUSTOM_REQUEST_PORT} resolve max_fails=0;
    keepalive 64;
}

map $http_upgrade $golem_router_connection {
    default upgrade;
    "" "";
}

# A proxy in front of the router that terminates TLS sets X-Forwarded-Proto.
map $http_x_forwarded_proto $golem_router_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

# Streams, such as server-sent events, invocation sessions and websockets, pass through without
# buffering and may stay open for a long time.
proxy_http_version 1.1;
proxy_buffering off;
proxy_request_buffering off;
proxy_read_timeout ${GOLEM_ROUTER_STREAM_TIMEOUT};
proxy_send_timeout ${GOLEM_ROUTER_STREAM_TIMEOUT};

# The original authority, with its port, selects the deployment in the worker service.
proxy_set_header Host $http_host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $golem_router_connection;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Forwarded-Proto $golem_router_forwarded_proto;

server {
    ${GOLEM_ROUTER_LISTEN}
    server_name ${GOLEM_ROUTER_MANAGEMENT_HOST};

    location ~ ^/v1/components/[^/]+/workers(/|$) {
        proxy_pass http://golem-worker-service;
    }

    location /v1/agents/ {
        proxy_pass http://golem-worker-service;
    }

    location / {
        proxy_pass http://golem-registry-service;
    }
}

server {
    ${GOLEM_ROUTER_LISTEN_DEFAULT}
    server_name _;

    location / {
        proxy_pass http://golem-worker-service-custom-request;
    }
}
