[package]
name = "component_name"
version = "0.0.1"
edition = "2024"

[profile.release]
opt-level = "s"
lto = true
strip = "symbols"

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
log = { version = "GOLEM_RUST_LOG_VERSION", features = ["kv"] }
golem-rust = { GOLEM_RUST_VERSION_OR_PATH, features = ["export_golem_agentic"] }
serde = { version = "GOLEM_RUST_SERDE_VERSION", features = ["derive"] }
serde_json = "GOLEM_RUST_SERDE_JSON_VERSION"

# Build the WIT bindings with the Golem wit-bindgen fork that golem-rust
# depends on. The fork adds an "outline-lift" optimization that shrinks the
# giant generated lift/lower wrappers embedded by golem-rust.
[patch.crates-io]
wit-bindgen = { git = "GOLEM_RUST_WIT_BINDGEN_GIT", rev = "GOLEM_RUST_WIT_BINDGEN_REV", version = "GOLEM_RUST_WIT_BINDGEN_VERSION" }
